---
source: src/app/tui/commands.rs
expression: "lines.join(\"\\n\")"
---
"" =>
  slash=None
  bang=NotBang
"plain text" =>
  slash=None
  bang=NotBang
"/" =>
  slash=None
  bang=NotBang
"/unknown-verb" =>
  slash=None
  bang=NotBang
"/exit" =>
  slash=Some(Exit)
  bang=NotBang
"/quit" =>
  slash=Some(Exit)
  bang=NotBang
"/model" =>
  slash=Some(OpenModels)
  bang=NotBang
"/model gpt-x" =>
  slash=Some(SetModel("gpt-x"))
  bang=NotBang
"/session-tree" =>
  slash=Some(OpenTree)
  bang=NotBang
"/session-fork" =>
  slash=Some(ForkAtLeaf)
  bang=NotBang
"/session-compact" =>
  slash=Some(Compact { instructions: None })
  bang=NotBang
"/session-compact focus tests first" =>
  slash=Some(Compact { instructions: Some("focus tests first") })
  bang=NotBang
"/session-export" =>
  slash=Some(Export { path: None })
  bang=NotBang
"/session-export /tmp/a.json" =>
  slash=Some(Export { path: Some("/tmp/a.json") })
  bang=NotBang
"/session-import" =>
  slash=Some(Usage("usage: /session-import <path>"))
  bang=NotBang
"/session-import x.json" =>
  slash=Some(Import { path: "x.json" })
  bang=NotBang
"/session" =>
  slash=Some(SessionDump)
  bang=NotBang
"/session extra" =>
  slash=Some(Usage("usage: /session (no arguments)"))
  bang=NotBang
"/session-resume" =>
  slash=Some(OpenSessionResume)
  bang=NotBang
"/session-resume abc" =>
  slash=Some(Usage("usage: /session-resume (no arguments)"))
  bang=NotBang
"/session-new" =>
  slash=Some(SessionNew)
  bang=NotBang
"/session-new x" =>
  slash=Some(Usage("usage: /session-new (no arguments)"))
  bang=NotBang
"/session-clone" =>
  slash=Some(SessionClone)
  bang=NotBang
"/session-clone x" =>
  slash=Some(Usage("usage: /session-clone (no arguments)"))
  bang=NotBang
"/session-name" =>
  slash=Some(SessionName { name: None })
  bang=NotBang
"/session-name n1" =>
  slash=Some(SessionName { name: Some("n1") })
  bang=NotBang
"/reload" =>
  slash=Some(Reload)
  bang=NotBang
"/reload arg" =>
  slash=Some(Usage("usage: /reload (no arguments)"))
  bang=NotBang
"/trust" =>
  slash=Some(Trust { mode: TrustCwd })
  bang=NotBang
"/trust parent" =>
  slash=Some(Trust { mode: TrustParent })
  bang=NotBang
"/trust deny" =>
  slash=Some(Trust { mode: Deny })
  bang=NotBang
"/trust bogus" =>
  slash=Some(Usage("usage: /trust [self|this_dir|parent|deny]"))
  bang=NotBang
"/history-copy-last" =>
  slash=Some(HistoryCopyLast)
  bang=NotBang
"/history-copy-last arg" =>
  slash=Some(Usage("usage: /history-copy-last (no arguments)"))
  bang=NotBang
"/theme dark" =>
  slash=Some(Theme { arg: Some("dark") })
  bang=NotBang
"/mcp" =>
  slash=Some(OpenMcp)
  bang=NotBang
"/mcps arg" =>
  slash=Some(Usage("usage: /mcp (no arguments)"))
  bang=NotBang
"!" =>
  slash=None
  bang=Empty { exclude_from_context: false }
"!!" =>
  slash=None
  bang=Empty { exclude_from_context: true }
"!ls -la" =>
  slash=None
  bang=Cmd { command: "ls -la", exclude_from_context: false }
"!!make test" =>
  slash=None
  bang=Cmd { command: "make test", exclude_from_context: true }
