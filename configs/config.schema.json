{
  "$defs": {
    "ActivityFoldStreamCollapse": {
      "enum": [
        "envelope",
        "clusters"
      ],
      "type": "string"
    },
    "AgentProfile": {
      "additionalProperties": false,
      "properties": {
        "model": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "system_prompt": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "AgentsConfig": {
      "properties": {
        "default_profile": {
          "default": "default",
          "type": "string"
        },
        "profiles": {
          "additionalProperties": {
            "$ref": "#/$defs/AgentProfile"
          },
          "default": {},
          "type": "object"
        }
      },
      "type": "object"
    },
    "ExecutionConfig": {
      "properties": {
        "model": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "system_prompt": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "HookEntry": {
      "properties": {
        "command": {
          "type": "string"
        },
        "env": {
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "type": "object"
        },
        "events": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "phase": {
          "default": "",
          "type": "string"
        },
        "requires_approval": {
          "default": false,
          "type": "boolean"
        },
        "timeout_secs": {
          "default": null,
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "command"
      ],
      "type": "object"
    },
    "HooksConfig": {
      "properties": {
        "global": {
          "default": [],
          "items": {
            "$ref": "#/$defs/HookEntry"
          },
          "type": "array"
        },
        "project": {
          "default": [],
          "items": {
            "$ref": "#/$defs/HookEntry"
          },
          "type": "array"
        },
        "user": {
          "default": [],
          "items": {
            "$ref": "#/$defs/HookEntry"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "LoopExampleConfig": {
      "additionalProperties": false,
      "properties": {
        "deny_bash_patterns": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "enabled": {
          "default": false,
          "type": "boolean"
        },
        "max_settles": {
          "default": null,
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "plan_state": {
          "default": false,
          "type": "boolean"
        },
        "progress_reminder": {
          "default": false,
          "type": "boolean"
        },
        "progress_reminder_stale_after": {
          "default": 3,
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "type": "object"
    },
    "McpServerConfig": {
      "properties": {
        "args": {
          "default": null,
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "command": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "env": {
          "additionalProperties": {
            "type": "string"
          },
          "default": null,
          "type": [
            "object",
            "null"
          ]
        },
        "headers": {
          "additionalProperties": {
            "type": "string"
          },
          "default": null,
          "type": [
            "object",
            "null"
          ]
        },
        "name": {
          "type": "string"
        },
        "transport": {
          "$ref": "#/$defs/McpTransportKind",
          "default": "stdio"
        },
        "url": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    },
    "McpTransportKind": {
      "enum": [
        "stdio",
        "sse"
      ],
      "type": "string"
    },
    "ModelsConfig": {
      "properties": {
        "default_model": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "models": {
          "additionalProperties": {
            "$ref": "#/$defs/XyModelEntryConfig"
          },
          "default": {},
          "type": "object"
        }
      },
      "type": "object"
    },
    "OtelConfig": {
      "properties": {
        "endpoint": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "environment": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "export_timeout_secs": {
          "default": 60,
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "exporter": {
          "$ref": "#/$defs/OtelExporterKind",
          "default": "none"
        },
        "headers": {
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "type": "object"
        },
        "observation_io": {
          "$ref": "#/$defs/OtelObservationIo",
          "default": "none"
        },
        "protocol": {
          "$ref": "#/$defs/OtelHttpProtocol",
          "default": "http-json"
        },
        "service_name": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "tool_observation_io": {
          "$ref": "#/$defs/OtelObservationIo",
          "default": "none"
        }
      },
      "type": "object"
    },
    "OtelExporterKind": {
      "enum": [
        "none",
        "otlp-http"
      ],
      "type": "string"
    },
    "OtelHttpProtocol": {
      "enum": [
        "http-binary",
        "http-json"
      ],
      "type": "string"
    },
    "OtelObservationIo": {
      "enum": [
        "none",
        "truncated",
        "full"
      ],
      "type": "string"
    },
    "PermissionBackend": {
      "enum": [
        "glob"
      ],
      "type": "string"
    },
    "PermissionConfig": {
      "properties": {
        "backend": {
          "$ref": "#/$defs/PermissionBackend",
          "default": "glob"
        },
        "enabled": {
          "default": false,
          "type": "boolean"
        },
        "filesystem": {
          "$ref": "#/$defs/PermissionFilesystemConfig",
          "default": {
            "read_allowed": [],
            "write_allowed": [],
            "write_denied": []
          }
        },
        "network": {
          "$ref": "#/$defs/PermissionNetworkConfig",
          "default": {
            "allowed_domains": [],
            "denied_domains": []
          }
        },
        "process": {
          "$ref": "#/$defs/PermissionProcessConfig",
          "default": {
            "allowed_paths": []
          }
        }
      },
      "type": "object"
    },
    "PermissionFilesystemConfig": {
      "properties": {
        "read_allowed": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "write_allowed": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "write_denied": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "PermissionNetworkConfig": {
      "properties": {
        "allowed_domains": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "denied_domains": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "PermissionProcessConfig": {
      "properties": {
        "allowed_paths": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "SecurityConfig": {
      "properties": {
        "enabled": {
          "default": true,
          "type": "boolean"
        },
        "permission": {
          "anyOf": [
            {
              "$ref": "#/$defs/PermissionConfig"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "type": "object"
    },
    "SessionConfig": {
      "properties": {
        "max_turns": {
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "ToolBatchConfig": {
      "additionalProperties": false,
      "properties": {
        "mode": {
          "$ref": "#/$defs/ToolBatchMode",
          "default": "barrier_parallel"
        }
      },
      "type": "object"
    },
    "ToolBatchMode": {
      "enum": [
        "sequential",
        "barrier_parallel"
      ],
      "type": "string"
    },
    "TuiActivityFoldConfig": {
      "additionalProperties": false,
      "properties": {
        "auto_on_rebuild": {
          "default": true,
          "type": "boolean"
        },
        "auto_on_turn_end": {
          "default": true,
          "type": "boolean"
        },
        "enabled": {
          "default": true,
          "type": "boolean"
        },
        "keep_recent_turns": {
          "default": 2,
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "stream_collapse": {
          "$ref": "#/$defs/ActivityFoldStreamCollapse",
          "default": "envelope"
        }
      },
      "type": "object"
    },
    "TuiConfig": {
      "properties": {
        "activity_fold": {
          "$ref": "#/$defs/TuiActivityFoldConfig",
          "default": {
            "auto_on_rebuild": true,
            "auto_on_turn_end": true,
            "enabled": true,
            "keep_recent_turns": 2,
            "stream_collapse": "envelope"
          }
        },
        "editor_history_seed_sessions": {
          "default": 1,
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "type": "object"
    },
    "XyCompactionSettingsConfig": {
      "properties": {
        "enabled": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "keepRecentTokens": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "model": {
          "anyOf": [
            {
              "$ref": "#/$defs/XyModelEntryConfig"
            },
            {
              "type": "null"
            }
          ]
        },
        "reserveTokens": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "thinkingLevel": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "XyModelEntryConfig": {
      "properties": {
        "api": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "api_key": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "base_url": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "compat": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "context_window": {
          "default": 0,
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "fallback": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "model": {
          "type": "string"
        },
        "provider": {
          "type": "string"
        },
        "thinking": {
          "default": true,
          "type": "boolean"
        },
        "thinking_level_map": {
          "additionalProperties": {
            "type": [
              "string",
              "null"
            ]
          },
          "default": null,
          "type": [
            "object",
            "null"
          ]
        },
        "thinking_levels": {
          "default": null,
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        }
      },
      "required": [
        "provider",
        "model"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "agents": {
      "$ref": "#/$defs/AgentsConfig",
      "default": {
        "default_profile": "",
        "profiles": {}
      }
    },
    "compaction": {
      "anyOf": [
        {
          "$ref": "#/$defs/XyCompactionSettingsConfig"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "execution": {
      "$ref": "#/$defs/ExecutionConfig",
      "default": {
        "model": null,
        "system_prompt": null
      }
    },
    "hooks": {
      "$ref": "#/$defs/HooksConfig",
      "default": {
        "global": [],
        "project": [],
        "user": []
      }
    },
    "loop_example": {
      "$ref": "#/$defs/LoopExampleConfig",
      "default": {
        "deny_bash_patterns": [],
        "enabled": false,
        "max_settles": null,
        "plan_state": false,
        "progress_reminder": false,
        "progress_reminder_stale_after": 3
      }
    },
    "mcp_servers": {
      "default": null,
      "items": {
        "$ref": "#/$defs/McpServerConfig"
      },
      "type": [
        "array",
        "null"
      ]
    },
    "models": {
      "$ref": "#/$defs/ModelsConfig",
      "default": {
        "default_model": null,
        "models": {}
      }
    },
    "otel": {
      "$ref": "#/$defs/OtelConfig",
      "default": {
        "endpoint": null,
        "environment": null,
        "export_timeout_secs": 60,
        "exporter": "none",
        "headers": {},
        "observation_io": "none",
        "protocol": "http-json",
        "service_name": null,
        "tool_observation_io": "none"
      }
    },
    "security": {
      "$ref": "#/$defs/SecurityConfig",
      "default": {
        "enabled": false,
        "permission": null
      }
    },
    "session": {
      "anyOf": [
        {
          "$ref": "#/$defs/SessionConfig"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "tool_batch": {
      "$ref": "#/$defs/ToolBatchConfig",
      "default": {
        "mode": "barrier_parallel"
      }
    },
    "tui": {
      "$ref": "#/$defs/TuiConfig",
      "default": {
        "activity_fold": {
          "auto_on_rebuild": true,
          "auto_on_turn_end": true,
          "enabled": true,
          "keep_recent_turns": 2,
          "stream_collapse": "envelope"
        },
        "editor_history_seed_sessions": 1
      }
    }
  },
  "title": "AppConfig",
  "type": "object"
}
