kind: llman.sdd.spec
name: infra-diagnostics
purpose: "诊断 — 启动计时 instrumentation 与性能 profiling。"
valid_scope[1]: src/infra/timing.rs
requirements[4]{req_id,title,statement}:
  d0,placeholder,"System SHALL 提供 opt-in 启动计时 instrumentation。"
  d1,"timing-collector","System MUST 提供 reset_timings、time label 与 print_timings，由 XYLITOL_TIMING 环境变量门控。"
  d2,"timing-points","System MUST 在 config load、ResourceLoader reload、ModelRegistry load、session restore 与 session create 插入 timing points。"
  d3,"timing-output","print_timings MUST 向 stderr 输出每步 ms 与 total。"
scenarios[5]{req_id,id,given,when,then}:
  d0,placeholder,未启用诊断,无操作,无变化
  d1,enabled,XYLITOL_TIMING 设为 1,启动运行,收集并打印 timing 数据
  d1,disabled,XYLITOL_TIMING 未设置或为 0,启动运行,无 timing 输出
  d2,points,启动经所有阶段,每阶段调用 time,5 个 timing points 均被记录
  d3,"stderr-output",timing 数据已收集,print_timings 被调用,"输出到 stderr，含每步 ms 与 total"
