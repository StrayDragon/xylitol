kind: llman.sdd.spec
name: "package-tui-interaction-modes"
purpose: "packages/xylitol-tui 双交互模式（Mode A inline / Mode B alt-screen 应用自管视口）的完整 Mode B：视口绘制、应用内选区、越界续选、松手复制、输入 dock 排除与生命周期。"
valid_scope[2]: "packages/xylitol-tui/",tests/
requirements[11]{req_id,title,statement}:
  ptim01,"dual-mode-seam","xylitol-tui MUST 支持两种交互模式：Mode A（inline / 终端 scrollback 与终端原生选区）与 Mode B（应用自管视口 + 应用内选区）。库 MUST 提供可观察的模式构造或切换入口；一次会话 MUST 只有一个主模式。运行中切换 MUST 等价于拆旧栈再装新栈（teardown 后再启动），MUST NOT 在同一渲染栈上混用终端原生选区与应用内选区。"
  ptim02,"mode-b-alt-viewport","Mode B MUST 使用应用自管视口承载 transcript（滚轮与程序滚动归应用）。Mode B 进入路径 SHOULD 经终端 alt-buffer（如 CSI ?1049h 或等价）；无论是否经 alt-buffer，退出/teardown MUST 恢复进入前的缓冲与光标可见性约定，且 MUST 关闭本模式启用的 mouse capture。"
  ptim03,"mode-b-drag-select","Mode B 在 mouse capture 开启且应用会话已 begin 时 MUST 将未修饰左键拖选接到应用内选区：按下记录锚点、拖动更新焦点、选区高亮出现在绘出的 transcript 可见行上。空选（锚点与焦点重合）MUST NOT 触发复制成功路径。"
  ptim04,"mode-b-edge-autoscroll","Mode B 拖选过程中，当指针贴近视口顶或底边缘时 MUST 自动滚动 transcript 并扩展选区，使选区可跨出当前可见页（越界续选）。自动滚动 MUST 与应用视口共用同一滚动机制，MUST NOT 依赖终端 scrollback 完成续选。引擎 idle/tick 路径 MUST 能推进该自动滚动。"
  ptim05,"mode-b-copy-on-release","Mode B 在左键松开且选区非空时 MUST 默认将选中纯文本写入剪贴板。缺省路径 MUST 能发出 OSC52（经 Terminal::write，且在差分 batch 外），并 MAY 同时或回退到本地剪贴板后端。该默认 MUST 可配置关闭。空选 MUST NOT 发出复制。"
  ptim06,"mode-b-input-exclude","Mode B 布局 MUST 将主输入面（Editor/Input 或等价 dock）置于 transcript 选区坐标系之外：绘出帧的底部 dock 行 MUST NOT 进入选区文本抽取；指针落在 dock 矩形内时 MUST NOT 以 dock 文本作为 transcript 拖选起点。实现 MAY 取消进行中的 transcript 选区。"
  ptim07,"mode-b-reuses-mouse-pipe","Mode B MUST 复用既有 opt-in mouse 管道（Enable/Disable mouse capture 与 InputEvent::Mouse 扇入），MUST NOT 另建平行的第二套鼠标事件源。默认路径下无态变的 Moved MUST NOT 强制整帧重绘。本要求 MUST NOT 规定折叠点击或 Mode A 产品默认开鼠标。"
  ptim08,"mode-a-preserves-emulator-selection","Mode A MUST 保持今日 inline 差分与终端 scrollback 路径作为默认产品取向的库能力；Mode A MUST NOT 承诺「开启 mouse capture 后仍完整保留终端原生选区，同时又提供无修饰应用内点选」。Mode A 文档与 API 说明 MUST 不暗示该组合可行。"
  ptim09,"mode-b-fixed-viewport-paint","Mode B 应用会话激活时，每帧绘出的行数 MUST 不超过终端高度；transcript 历史 MUST 由应用 ScrollView（或等价）持有，绘出仅可见窗口加底部 dock。Mode B MUST NOT 通过向终端主缓冲追加行来滚动历史（即 MUST NOT 依赖终端 scrollback 保存 Mode B transcript）。"
  ptim10,"mode-b-wheel-app-scroll","Mode B 应用会话激活时，落在 transcript 视口内的滚轮事件 MUST 滚动应用视口，MUST NOT 依赖终端 scrollback 滚历史。"
  ptim11,"mode-b-suspend-restores-session","Mode B 应用会话激活期间若经 suspend/resume 终端（如外部编辑器），resume 后 MUST 重新进入 Mode B 会话所持有的 alt-buffer（若使用）与 mouse capture，使 application_session_active 与终端实际状态一致。"
scenarios[11]{req_id,id,given,when,then,feature}:
  ptim01,ptim01-unit,"dual-mode-seam 约束由包级单测覆盖（非 BDD harness）",审查实现与对应测试,"行为符合本 requirement 陈述",false
  ptim02,ptim02-unit,"mode-b-alt-viewport 约束由包级单测覆盖（非 BDD harness）",审查实现与对应测试,"行为符合本 requirement 陈述",false
  ptim03,ptim03-unit,"mode-b-drag-select 约束由包级单测覆盖（非 BDD harness）",审查实现与对应测试,"行为符合本 requirement 陈述",false
  ptim04,ptim04-unit,"mode-b-edge-autoscroll 约束由包级单测覆盖（非 BDD harness）",审查实现与对应测试,"行为符合本 requirement 陈述",false
  ptim05,ptim05-unit,"mode-b-copy-on-release 约束由包级单测覆盖（非 BDD harness）",审查实现与对应测试,"行为符合本 requirement 陈述",false
  ptim06,ptim06-unit,"mode-b-input-exclude 约束由包级单测覆盖（非 BDD harness）",审查实现与对应测试,"行为符合本 requirement 陈述",false
  ptim07,ptim07-unit,"mode-b-reuses-mouse-pipe 约束由包级单测覆盖（非 BDD harness）",审查实现与对应测试,"行为符合本 requirement 陈述",false
  ptim08,ptim08-unit,"mode-a-preserves-emulator-selection 约束由包级单测/文档审查覆盖（非 BDD harness）",审查实现与对应测试,"行为符合本 requirement 陈述",false
  ptim09,ptim09-unit,"mode-b-fixed-viewport-paint 约束由包级单测覆盖（非 BDD harness）",审查实现与对应测试,"行为符合本 requirement 陈述",false
  ptim10,ptim10-unit,"mode-b-wheel-app-scroll 约束由包级单测覆盖（非 BDD harness）",审查实现与对应测试,"行为符合本 requirement 陈述",false
  ptim11,ptim11-unit,"mode-b-suspend-restores-session 约束由包级单测覆盖（非 BDD harness）",审查实现与对应测试,"行为符合本 requirement 陈述",false
