kind: llman.sdd.spec
name: "app-tui-trust"
purpose: 产品 TUI 项目信任选择器（ChoicePrompt）；信任后 yolo。
valid_scope[1]: src/app/tui/
requirements[5]{req_id,title,statement}:
  meta0,"capability-shell","本 capability 由变更 c490-add-app-tui-trust-prompt 引入；归档合并后以 delta 增补的 requirements 为准。本壳 MUST 保持非空以满足 BDD 护栏。"
  atr1,"choice-prompt-not-stdio","产品 `--tui` 路径在需要 Ask trust 时 MUST 在 raw-mode TUI 内用 packages/xylitol-tui ChoicePrompt（替换 editor 槽）完成选择；MUST NOT 调用 prompt_trust_options_stdio 或等价 stderr 数字菜单。"
  atr2,"theme-and-cancel","Trust ChoicePrompt MUST 使用 Palette::dark()（或等价）choice_prompt_theme；Esc/取消 MUST 视为不信任（deny）；提交 MUST 经 TrustManager 写入持久 store。"
  atr3,"yolo-after",项目已信任后产品 TUI MUST NOT 实现逐工具审批 UI；工具默认执行；MUST 保留 hook 扩展点。
  atr4,"slash-persist-no-auto-reload","产品 /trust slash MUST 经 Driver/composition 缝调用 TrustManager（或等价端口）持久化 cwd/parent/deny 决策；MUST NOT 从 app/tui 直接 reach infra::trust；MUST NOT 解冻 Choice/Plate 活板作为本命令唯一路径；写盘成功后本会话 MUST NOT 自动重载项目 skills/MCP/context（用户显式 /reload 或重启除外）。"
scenarios[7]{req_id,id,given,when,then}:
  meta0,"shell-present","","列出 llmanspec/specs/app-tui-trust",spec.toon 存在且 purpose 为中文
  atr1,"no-stdio-menu","需要 Ask 且启动 --tui",进入产品 TUI,"editor 槽为 ChoicePrompt 且无 Choice [1-N] stderr 菜单"
  atr1,"options-from-store","",构造 trust 选择,"选项 label 来自 TrustManager::get_trust_options"
  atr2,"esc-denies",ChoicePrompt 已打开,按 Esc,不信任且不写 trust 肯定决策（或等价 deny）
  atr3,"no-tool-approval-ui",项目已信任,模型请求工具,无逐工具确认弹层
  atr4,"persist-cwd",idle 且 trust store 可测,/trust,store 含当前 cwd 信任决策
  atr4,"no-auto-reload",idle,/trust 成功,reload_runtime 调用次数为 0
