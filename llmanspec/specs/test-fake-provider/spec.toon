kind: llman.sdd.spec
name: "test-fake-provider"
purpose: Fake 与 mock provider：用于 agent 行为的确定性测试。
valid_scope[1]: "infra 层 fake/mock provider"
requirements[2]{req_id,title,statement}:
  r38,"fake-provider","System MUST 实现 FakeProvider，实现 XyModel，经 ScenarioStep 序列返回预配置响应。"
  r45,"scenario-orchestration","System MUST 支持编排多步场景：text -> tool_call -> tool_result -> text，含可配置 delay 与经 ScenarioStep 的错误注入。"
scenarios[4]{req_id,id,given,when,then,feature}:
  r38,happy,"FakeProvider 配置为仅 text 的 ScenarioStep::Text",generate_content() 被调用,响应流 yield 单个含预定 text 的 LlmResponse,false
  r38,tool-call,"FakeProvider 配置 ScenarioStep::ToolCall，含 preset name 与 args",generate_content() 被调用,"响应含 Part::FunctionCall，name 与 args 与配置一致",false
  r38,delay,"FakeProvider 配置 ScenarioStep::Delay(50ms) 后接 text",generate_content() 被调用,调用至少耗时 50ms 后返回 text 响应,false
  r45,multi-turn,FakeProvider 配置多回合场景（text、tool_call、tool_result、text）,跨对话回合调用 generate_content(),每次调用按序返回预期 step；tool_result step 被消费而不产生响应,false
