kind: llman.sdd.spec
name: package-ai-bridge-accounting
purpose: "xylitol-ai-bridge 多源上下文 token 计量与 TokenProvenance。"
valid_scope[2]: packages/xylitol-ai-bridge/,src/agent/compaction/
requirements[6]{req_id,title,statement}:
  paa1,"计量优先级","上下文 token 估计 MUST 按固定优先级解析来源：Api，然后 RemoteCount，然后 LocalTokenizer，然后 Heuristic；结果 MUST 携带 TokenProvenance（或等价枚举）标明实际采用的来源。"
  paa2,"Api-锚点规则","当存在适用于当前会话 prefix/leaf 的可信厂商 usage 时 MUST 优先用作 Api 锚点；因 abort 或 error 结束的回合 usage、以及 compaction 之后不再描述当前 prefix 的旧 usage，MUST NOT 作为锚点。"
  paa3,"禁止流上全量 encode","generate_stream 热路径 MUST NOT 在每个文本 delta 上对累计全文调用完整本地 tokenizer.encode；本地精确计数 MUST 仅在显式 estimate 调用、流结束补洞或经文档化的节流策略下发生。"
  paa4,"Heuristic-诚实标注","当最终采用 Heuristic 时，ContextTokenEstimate 的 provenance MUST 为 Heuristic；下游展示层若使用该结果 MUST 能区分于 Api/LocalTokenizer。"
  paa5,"RemoteCount-可降级","RemoteCount（如 Anthropic count_tokens）MUST 可配置关闭；调用失败或超时时 MUST 降级到 LocalTokenizer 或 Heuristic，且 MUST NOT 将失败结果标为 Api。"
  paa6,"LocalTokenizer-注册与缓存","LocalTokenizer MUST 经 registry 将 model_id 映射到 Builtin 或 HuggingFace tokenizer.json 源；HuggingFace 文件下载 MUST 为 opt-in 或显式 prefetch，默认 MUST NOT 静默拉取大文件；缓存命中后 MUST 可离线加载。"
scenarios[8]{req_id,id,given,when,then}:
  paa1,"prefer-api","消息集含可信 last Api usage 且其后无新消息","调用 estimate_context","provenance 为 Api 且 tokens 反映该 usage"
  paa1,"fallback-local","无 Api 锚点且 registry 命中已加载 LocalTokenizer","调用 estimate_context","provenance 为 LocalTokenizer"
  paa1,"fallback-heuristic","无 Api、RemoteCount 不可用、无 LocalTokenizer","调用 estimate_context","provenance 为 Heuristic 且仍返回估计值"
  paa2,"abort-not-anchor","最近 assistant 为 abort 且带非零 usage","估计当前上下文","不得仅因该 usage 将 provenance 标为 Api 锚点"
  paa3,"no-per-delta-encode","正在流式生成且开启本地 tokenizer","仅处理 TextDelta 热路径","不因每个 delta 触发全文 encode"
  paa4,"heuristic-provenance","估计结果来自 chars/4","检查 ContextTokenEstimate","provenance 为 Heuristic"
  paa5,"remote-fail-degrade","RemoteCount 已启用但网络失败","估计上下文","降级到 LocalTokenizer 或 Heuristic 且 provenance 不是 Api"
  paa6,"hf-opt-in","模型映射到 HuggingFace tokenizer 且本地无缓存且未 opt-in 下载","估计上下文","不静默下载大文件并降级到 Heuristic 或明确错误策略后降级"
