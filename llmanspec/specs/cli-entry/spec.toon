kind: llman.sdd.spec
name: "cli-entry"
purpose: "CLI 统一入口：默认 TUI；surface（tui/print）与 ops（resources/server/tokenizer）；bootstrap/dispatch；产品 slash 以 session-* 为准。"
valid_scope[2]: src/,tests/
requirements[22]{req_id,title,statement}:
  r67,"info-fields",SlashCommandInfo MUST 携带 name、description、source 与 source_info 字段。
  r68,"source-enum",SlashCommandSource MUST 恰为 prompt 或 skill 之一（extension 若未实现 MUST NOT 作为产品必选项）。
  r69,"builtin-table","产品对外 slash 与 GetCommands 内建表 MUST 同源自同一产品命令 SSOT（见 app-tui-commands）；名称 MUST 以 session-* /model /exit 等产品名为准（PI_DELTAS A03）；MUST NOT 再以 pi 短名表（/tree /fork /export /compact /resume /new 等）作为 GetCommands 或文档的权威清单；产品解析 MUST NOT 将上述废弃短名识别为有效命令入口。"
  r70,dispatch,产品 TUI idle slash MUST 经 commands→effects→Driver/dispatch；MUST NOT 依赖已移除的 stdio rpc。
  ce1,"app-directory","CLI 模块 MUST 位于 src/app/cli/，print MUST 为其子模式；app 面 MUST NOT reach agent::runtime / agent::capabilities / agent::tools。"
  ce2,"no-silent-fallback","配置文件存在但零可加载模型时，经 bootstrap 的表面（TUI/print/--list-models/server）MUST 硬失败并明确报错指向配置，MUST NOT 静默回退到 env 占位默认（如 gpt-4o）后继续。"
  ce6,"driver-abstraction","MUST 提供 app::Driver；InProcessDriver 与 RemoteDriver MUST 同实现；切换本地/远程 MUST 只换构造。"
  ce7,"composition-root-ports","组合根 MUST 从 infra 构造 SessionStore/EventSink 注入装配。"
  ce8,"server-subcommands",CLI MUST 提供 server run/install/stop 子命令。
  ce9,"assembly-via-bootstrap","cli 与 server MUST 经 app::core::bootstrap 装配，MUST NOT 内联第二套装配。"
  ce10,"dispatch-via-shared",产品 TUI 命令执行 MUST 委托 dispatch/Driver，MUST NOT 复制第二套语义。
  ce11,"rpc-removed","stdio RPC（rpc.rs / --rpc / feature）MUST 保持移除。"
  ce12,"default-tui-entry","TTY 且无表面子命令时 MUST 默认进入产品 TUI。"
  ce13,"print-requires-prompt",print MUST 有非空 prompt；MUST NOT 使用 Hello! 占位。
  "ce-st1","session-tree-kind-api",Driver MUST 暴露 SessionTreeKind 区分的 session_tree / travel_session_tree；至少 MessageHistory；未实现 kind MUST 明确错误。
  ce14,"stable-session-id-on-run","InProcessDriver::run MUST 复用 bootstrap session_id，MUST NOT 每轮新建 Uuid 文件。"
  ce15,"tokenizer-cache-subcommands","CLI MUST 提供顶层动词 tokenizer（跨面 ops，MUST NOT 仅挂在 tui 下），叶子至少含 status、download、clean：status MUST 可报告缓存根与条目（及可选 --model 的 builtin/local/cached/missing/unmapped）；download MUST 为显式 opt-in（调用即同意；TTY 默认可二次确认，--yes 跳过），MUST 在确认摘要中告知 repo/file、HF 基址与落盘路径，MUST NOT 在估计热路径静默下载；无配置映射且无显式 owner/repo 时 MUST 失败并提示配置 tokenizer 字段或 CLI 形状，MUST NOT 猜测下载目标；clean MUST 支持 --all 或按 model/target 删除；上述子命令 MUST 早退且 MUST NOT 经 bootstrap 装配会话/MCP；实现 MUST 委托 bridge 缓存 API，MUST NOT 在 CLI 内直接发起 HTTP。"
  ce16,"cli-surface-vs-ops","CLI MUST 区分表面动词与管理动词：表面至少含 tui 与 print（xylitol tui 进入 TUI；xylitol print 进入一次性 print 且须非空 prompt）；管理动词 resources、server、tokenizer MUST 保持顶层，MUST NOT 挪入 tui 子树；TTY 裸跑默认 TUI 的语义 MUST 保持；MUST NOT 提供顶层 --tui/--print/-p/--prompt 或位置 PROMPT 作为表面切换别名（print 的 --prompt/-p 仅允许挂在 print 子命令下）。"
  ce17,"config-load-fail-closed","load_app_config（或等价）失败（含模板渲染、YAML 解析、IO）时，bootstrap MUST 返回硬错误且经其装配的全表面 MUST 非零退出；MUST NOT 仅 Warning 后继续并用 env 默认模型进入 TUI/print。"
  ce18,"unset-model-display","当前未选中模型时，产品面展示的模型名 MUST 为 NOT-SET（或文档化的等价明确占位）；MUST NOT 将未显式配置/未传 --model 的状态显示为 gpt-4o 等厂商默认模型名。"
  ce19,"surface-owned-flags","CLI MUST 将表面旗标挂在表面动词下：`xylitol tui`（含可选 `run`）MUST 接受 --session/--model/--list-models/--trust/--no-trust/--config/--no-color；`xylitol print` MUST 接受 --session/--model/--config/--no-color/--trust/--no-trust 且 MUST NOT 接受 --list-models；顶层 MUST NOT 再提供上述旗标（解析 MUST 失败）。print 的 --trust/--no-trust MUST 经 bootstrap trust_override 生效（interactive=false，MUST NOT 弹出 ChoicePrompt）。`tui --session` 与 `tui run --session` MUST 等价生效。"
  ce20,"resume-hint-on-exit","TUI 与 print 正常退出后，若当前 session_id 出现在 Driver list_sessions（或等价已持久化判定）中，CLI MUST 向 stderr 打印恰好一行 `Resume by $ xylitol tui --session <uuid>`；未持久化或无 session_id 时 MUST NOT 打印该行。"
scenarios[22]{req_id,id,given,when,then,feature}:
  r67,info-fields-unit,"SlashCommandInfo 类型",检查字段,"含 name/description/source/source_info",false
  r68,source-enum-unit,SlashCommandSource,枚举成员,"恰为 prompt 或 skill",false
  r69,builtin-table-unit,"GetCommands 与产品 slash SSOT",对照表,产品名同源且无废弃短名权威清单,false
  r70,dispatch-path-unit,"产品 TUI idle slash",执行路径,"经 commands→effects→Driver/dispatch",false
  ce1,cli-under-app-unit,源码布局,"定位 CLI 模块","位于 src/app/cli/；面不 reach agent 内部",false
  ce2,no-silent-fallback-unit,配置存在但零可加载模型,"经 bootstrap 启动表面",硬失败并指向配置,false
  ce6,driver-abstraction-unit,"InProcessDriver 与 RemoteDriver",切换构造,"同实现 Driver trait",false
  ce7,composition-ports-unit,组合根装配,"注入 SessionStore/EventSink","从 infra 构造；无 agent::facade",false
  ce8,server-subcommands-unit,"CLI server 子命令","解析 run/install/stop",子命令存在,false
  ce9,assembly-via-bootstrap-unit,"cli 与 server 装配",跟踪调用,"经 app::core::bootstrap",false
  ce10,dispatch-via-shared-unit,"产品 TUI 命令执行",跟踪调用,"委托 dispatch/Driver",false
  ce11,rpc-removed-unit,"仓库与 feature","检查 rpc 路径","stdio RPC 保持移除",false
  ce12,default-tui-entry-unit,"TTY 且无表面子命令","启动 xylitol","默认进入产品 TUI",false
  ce13,print-requires-prompt-unit,"print 模式","缺 prompt 启动","失败且无 Hello! 占位",false
  ce-st1,session-tree-kind-api-unit,"Driver session_tree API","调用 MessageHistory kind","区分 kind；未实现返回明确错误",false
  ce14,stable-session-id-unit,"InProcessDriver::run","多轮 run","复用 bootstrap session_id",false
  ce15,tokenizer-ops-bdd,"顶层 tokenizer 动词","跑 tests/features/cli-entry tokenizer 场景","status/download/clean 早退且委托 bridge",false
  ce16,surface-vs-ops-bdd,"表面与 ops 动词","跑 tests/features/cli-entry surface 场景","tui/print 与 resources/server/tokenizer 分层",false
  ce17,config-load-fail-closed-unit,"load_app_config 失败","经 bootstrap 装配",硬错误非零退出,false
  ce18,unset-model-display-unit,未选中模型,读取产品面模型名展示,"为 NOT-SET 或文档化占位",false
  ce19,surface-owned-flags-bdd,表面旗标归属,"跑 tests/features/cli-entry flags 场景",旗标挂表面动词；顶层拒绝,false
  ce20,resume-hint-bdd,"正常退出且 session 已持久化","跑 tests/features/cli-entry resume-hint 场景","stderr 恰好一行 Resume by …",false
