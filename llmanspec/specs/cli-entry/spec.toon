kind: llman.sdd.spec
name: "cli-entry"
purpose: "CLI 入口：默认 TUI、print 需 prompt、bootstrap/dispatch、server 子命令；产品 slash 以 session-* 为准。"
valid_scope[2]: src/,tests/
requirements[16]{req_id,title,statement}:
  sc1,"info-fields","SlashCommandInfo MUST 携带 name、description、source 与 source_info 字段。"
  sc2,"source-enum","SlashCommandSource MUST 恰为 prompt 或 skill 之一（extension 若未实现 MUST NOT 作为产品必选项）。"
  sc3,"builtin-table","agent 内 builtin 命令表 MAY 保留历史短名供 GetCommands；产品 TUI 对外 slash MUST 以 session-* /model /exit 等为准（见 app-tui-commands 与 PI_DELTAS A03），MUST NOT 要求产品识别已废弃的短名 /tree /fork /export 作为唯一入口。"
  sc4,dispatch,产品 TUI idle slash MUST 经 commands→effects→Driver/dispatch；MUST NOT 依赖已移除的 stdio rpc。
  ce1,"app-directory","CLI 模块 MUST 位于 src/app/cli/，print MUST 为其子模式；app 面 MUST NOT reach agent::runtime / agent::session / agent::tools。"
  ce2,"no-silent-fallback","配置文件存在但零可加载模型时，CLI MUST 明确报错指向配置，MUST NOT 静默回退到占位默认。"
  ce6,"driver-abstraction","MUST 提供 app::Driver；InProcessDriver 与 RemoteDriver MUST 同实现；切换本地/远程 MUST 只换构造。"
  ce7,"composition-root-ports","组合根 MUST 从 infra 构造 SessionStore/EventSink 注入装配；MUST NOT 经已删除的 agent::facade。"
  ce8,"server-subcommands","CLI MUST 提供 server run/install/stop 子命令。"
  ce9,"assembly-via-bootstrap","cli 与 server MUST 经 app::core::bootstrap 装配，MUST NOT 内联第二套装配。"
  ce10,"dispatch-via-shared","产品 TUI 命令执行 MUST 委托 dispatch/Driver，MUST NOT 复制第二套语义。"
  ce11,"rpc-removed","stdio RPC（rpc.rs / --rpc / feature）MUST 保持移除。"
  ce12,"default-tui-entry","TTY 且无 one-shot prompt 时 MUST 默认进入产品 TUI。"
  ce13,"print-requires-prompt","print MUST 有非空 prompt；MUST NOT 使用 Hello! 占位。"
  "ce-st1","session-tree-kind-api","Driver MUST 暴露 SessionTreeKind 区分的 session_tree / travel_session_tree；至少 MessageHistory；未实现 kind MUST 明确错误。"
  ce14,"stable-session-id-on-run","InProcessDriver::run MUST 复用 bootstrap session_id，MUST NOT 每轮新建 Uuid 文件。"
scenarios[16]{req_id,id,given,when,then}:
  sc1,fields,skill 命令注册,查询 SlashCommandInfo,source 为 Skill 且 source_info 有值
  sc2,"source-values",枚举来源,检查,仅为 prompt 或 skill
  sc3,"product-slash-prefix",产品 SlashCommandSource,列出,含 session-tree 且不以短名 tree 为唯一入口
  sc4,"dispatch-export",用户 /session-export,经 effects,导出路径执行
  ce1,"cli-under-app",检查源码树,src/app/cli,存在且无 src/app/print 顶级模块
  ce2,"typo-error",配置 models 因 typo 为空,启动 CLI,报错指向配置
  ce6,"same-handler-both-drivers",同一 handler,InProcess 与 Remote,事件序列同构
  ce7,"cli-constructs-ports",追踪装配,注入,含 SessionStore 与 EventSink
  ce8,"server-stop-signals",server 有 lock PID,xylitol server stop,SIGTERM 该 PID
  ce9,"server-bootstrap",cwd 有 AGENTS.md,server 启动,经 bootstrap 注入 context
  ce10,"tui-model-works",TUI 运行,/model id,经 dispatch 切换
  ce11,"rpc-files-gone",检查树,rpc.rs 与 --rpc,均不存在
  ce12,"bare-tty-tui",TTY 无 prompt,运行 xylitol,进入 TUI
  ce13,"no-hello-fallback",非 TTY 无 prompt,运行,错误退出且无 Hello!
  "ce-st1","message-history-tree",session 有消息,session_tree(MessageHistory),非空树
  ce14,"stable-id",同一 Driver 两次 run,session_id,保持不变
