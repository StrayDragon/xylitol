kind: llman.sdd.spec
name: "infra-process"
purpose: Shell 进程管理 — 子进程 spawn、进程组与取消。
valid_scope[2]: "infra 层 process","protocol 层"
requirements[4]{req_id,title,statement}:
  p1,"bash-discovery",System MUST 跨平台定位可用的 bash：Windows 上 Git Bash，Unix 上 /bin/bash，回退到 sh。
  p2,"shell-env",System MUST 构造注入 agent bin 目录后的 shell PATH 环境。
  p3,"process-group",System MUST 支持按进程整树终止：在所有平台上结束目标进程及其所有子进程。
  p4,"child-wait",System MUST 等待子进程退出并取得 exit code，MUST NOT 因 detached 后代进程持有继承 stdio handle 而挂起。
scenarios[4]{req_id,id,given,when,then,feature}:
  p1,macos,"macOS 且存在 /bin/bash","执行定位","bash path 为 /bin/bash 且 shell config 使用 -c",false
  p2,path,"agent bin dir 为 /home/user/.xylitol/bin","构造环境","结果 PATH 含 /home/user/.xylitol/bin",false
  p3,kill-tree,进程及其子进程运行中,"执行整树终止","进程及所有子进程收到 SIGKILL",false
  p4,wait,"子进程已退出但 stdout pipe 仍打开","等待子进程","函数等待 pipe idle 后返回 exit code",false
