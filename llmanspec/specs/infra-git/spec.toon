kind: llman.sdd.spec
name: "infra-git"
purpose: Git 仓库操作 — 分支管理、仓库发现与 URL 解析。
valid_scope[1]: "infra 层 git"
requirements[4]{req_id,title,statement}:
  g1,"repo-detection",System MUST 提供 find_git_repo(cwd)，向上遍历目录查找 .git 目录或 worktree 文件，返回 repo path、common git dir 与 HEAD path。
  g2,"branch-detection",System MUST 提供 get_current_branch(git_dir)，读取 HEAD 引用并返回当前分支名，detached HEAD 时返回 null。
  g3,"branch-watch",System MUST 支持经文件系统 watcher 监视 HEAD 文件的分支变更。
  g4,"url-parsing","System MUST 提供 parse_git_url(url)，处理 SCP-like、HTTPS、SSH 与 git protocol URL，并提取 ref。"
scenarios[4]{req_id,id,given,when,then,feature}:
  g1,discovery,"cwd 在 git repo 或 worktree 内","find_git_repo 被调用","正确返回 repo path、common git dir 与 HEAD path",false
  g2,branch,"HEAD 指向 refs/heads/main 或为 detached","get_current_branch 被调用","命名 ref 返回 main，detached 返回 null",false
  g3,watch,"HEAD 文件上设置了 file watcher","HEAD 文件被修改",分支变更回调被调用,false
  g4,urls,"提供 SCP、HTTPS、SSH 与 git 格式 URL","parse_git_url 被调用","每种格式正确提取 host 与 path",false
