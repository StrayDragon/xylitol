kind: llman.sdd.spec
name: "user-experience"
purpose: 用户体验 — 鉴权引导消息、错误消息与启动诊断。
valid_scope[1]: src/app/cli/
requirements[4]{req_id,title,statement}:
  ux1,"login-help",System MUST 提供 get_provider_login_help，返回引用 /login 与文档路径的引导。
  ux2,"no-models",无可用模型时，System MUST 提供 format_no_models_available_message。
  ux3,"no-model-selected",未选择模型时，System MUST 提供 format_no_model_selected_message。
  ux4,"no-api-key",System MUST 提供 format_no_api_key_found_message，含 provider 名称。
scenarios[4]{req_id,id,given,when,then,feature}:
  ux1,login-help,"用户需要 provider 设置引导","调用 get_provider_login_help","消息含 /login 与文档路径",false
  ux2,no-models,"model registry 为空","调用 format_no_models_available_message","消息含 /login 与 providers 文档提示",false
  ux3,no-model-selected,未选择模型,"调用 format_no_model_selected_message",消息含登录/选模引导,false
  ux4,no-api-key,"provider 无 API key","调用 format_no_api_key_found_message","消息含 provider 名与 /login",false
