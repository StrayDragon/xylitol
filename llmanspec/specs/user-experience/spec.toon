kind: llman.sdd.spec
name: "user-experience"
purpose: 用户体验 — 鉴权引导消息、错误消息与启动诊断。
valid_scope[2]: src/app/cli/logging.rs,src/domain/types.rs
requirements[5]{req_id,title,statement}:
  ux0,placeholder,System SHALL 为常见配置问题提供用户友好引导。
  ux1,"login-help",System MUST 提供 get_provider_login_help，返回引用 /login 与文档路径的引导。
  ux2,"no-models",无可用模型时，System MUST 提供 format_no_models_available_message。
  ux3,"no-model-selected",未选择模型时，System MUST 提供 format_no_model_selected_message。
  ux4,"no-api-key",System MUST 提供 format_no_api_key_found_message，含 provider 名称。
scenarios[0]:
