kind: llman.sdd.spec
name: "provider-integration"
purpose: "Provider integration — auth storage, API key resolution, model registry, provider attribution headers, and display names."
valid_scope[1]: src
requirements[10]{req_id,title,statement}:
  pi0,placeholder,System SHALL support provider registration with configurable API keys base URLs and headers.
  cv1,"config-value-parser","System MUST provide a ConfigValueResolver that parses literal env-var template and shell-command config values."
  cv2,"env-var-interpolation","ConfigValueResolver MUST interpolate $VAR and ${VAR} and ${VAR:-default} environment variable references."
  cv3,"shell-command-execution","ConfigValueResolver MUST execute commands prefixed with ! via std::process::Command with 10-second timeout and cache results for process lifetime."
  cv4,"header-resolution",ConfigValueResolver MUST provide resolve_headers that applies resolution to all values in a header map.
  cv5,"auth-integration",AuthStorage and ProviderConfig MUST use ConfigValueResolver when resolving API keys and custom headers.
  pa1,"attribution-headers","System MUST inject provider-specific attribution headers for OpenRouter NVIDIA NIM Cloudflare and Vercel AI Gateway."
  pa2,"opencode-session-headers","System MUST inject x-opencode-session and x-opencode-client headers for OpenCode providers."
  pa3,"provider-display-names","System MUST provide a display-name lookup table covering all 27+ built-in providers."
  pa4,"attribution-integration",The model resolver MUST call merge_provider_attribution_headers when building HTTP requests.
scenarios[14]{req_id,id,given,when,then}:
  pi0,placeholder,no providers configured,nothing happens,nothing changes
  cv1,literal,a config value is a plain string,it is resolved,the literal string is returned
  cv2,"env-var",a config value is MY_KEY and MY_KEY is set in env,the value is resolved,the env var value is returned
  cv2,"missing-env",a config value is MISSING and the var is unset,the value is resolved,None is returned
  cv3,"shell-cmd","'a config value is \"!echo hello\"'",the command executes within 10 seconds,hello is returned
  cv3,"shell-cache",same command is resolved twice,the value is cached,"the second call does not re-execute"
  cv4,"headers-map",a header map with env refs is provided,resolve_headers is called,only resolved values appear in the result
  cv5,"header-map",ProviderConfig has custom headers with env references,headers are resolved before request,resolved values appear in the HTTP request
  pa1,openrouter,a request targets an OpenRouter model,attribution headers are merged,"HTTP-Referer https://pi.dev and X-OpenRouter-Title pi are present"
  pa1,nvidia,a request targets an NVIDIA NIM model,attribution headers are merged,"X-BILLING-INVOKE-ORIGIN Pi is present"
  pa2,opencode,a request targets an OpenCode model with a session ID,attribution headers are merged,"x-opencode-session and x-opencode-client are present"
  pa3,lookup,provider id is openrouter,provider_display_name is called,OpenRouter is returned
  pa3,fallback,provider id is unknown,provider_display_name is called,the raw id is returned
  pa4,integration,a model request is being built,merge_provider_attribution_headers is called,headers are injected into the HTTP request