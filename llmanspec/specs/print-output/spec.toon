kind: llman.sdd.spec
name: "print-output"
purpose: "Print mode (non-interactive) output rendering — streams TextDelta to stdout, reasoning to stderr, and tool summaries."
valid_scope[2]: src/,tests/
requirements[4]{req_id,title,statement}:
  r1,"streaming-output","System MUST stream agent text output to stdout in real-time in Print mode."
  r2,"tool-display",System MUST display tool execution name and result summary in Print mode.
  r3,"thinking-to-stderr","System MUST stream reasoning/thinking content to stderr in Print mode (not stdout) so the formal answer stays unpolluted, wrapping it in <think>...</think> and MUST NOT double-wrap when the model already emits its own <think> tags."
  r4,"message-dedup","System MUST write only incremental TextDelta to stdout in Print mode and MUST NOT write the accumulated MessageUpdate payload to stdout to avoid prefix-repetition output."
scenarios[5]{req_id,id,given,when,then}:
  r1,happy,agent emits TextDelta events,Print mode is active,text appears on stdout progressively
  r2,happy,agent calls read tool then bash tool,Print mode displays results,"each tool shows [Tool: name] summary line"
  r3,"thinking-streamed",a model emits ThinkingDelta events,Print mode is active,thinking text appears on stderr wrapped in <think> tags and stdout stays clean
  r3,"embedded-tags",a model emits its own <think>...</think> tags inside ThinkingDelta,Print mode renders it,no second <think> wrapper is added
  r4,"text-delta-only",a model emits TextDelta and MessageUpdate for the same content,Print mode renders it,stdout contains each token exactly once
