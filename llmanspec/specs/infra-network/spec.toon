kind: llman.sdd.spec
name: "infra-network"
purpose: 网络配置 — HTTP 代理设置、idle 超时与 dispatcher 配置。
valid_scope[2]: "infra 层配置","infra 层 settings"
requirements[6]{req_id,title,statement}:
  nc0,placeholder,System SHALL 支持可配置的 HTTP 代理与 idle 超时设置。
  nc1,"proxy-config",System MUST 从 httpProxy 设置应用 HTTP_PROXY 与 HTTPS_PROXY 环境变量。
  nc2,"idle-timeout",System MUST 用可配置的 connect_timeout、read_timeout 与 pool_idle_timeout 配置 reqwest Client。
  nc3,"timeout-parser",System MUST 提供 parse_http_idle_timeout_ms，接受字符串 30 sec 或数值毫秒。
  nc4,"timeout-choices",System MUST 提供 HTTP_IDLE_TIMEOUT_CHOICES 常量，含预设 30s、1min、2min、5min、disabled。
  nc5,"settings-stubs",System SHALL 向 Settings 添加 httpProxy、httpIdleTimeoutMs、websocketConnectTimeoutMs 字段。
scenarios[7]{req_id,id,given,when,then,feature}:
  nc0,placeholder,未配置网络,无操作,无变化,false
  nc1,proxy,"'httpProxy 设为 \"http://proxy.example:8080\"'",apply_http_proxy_settings 被调用,HTTP_PROXY 与 HTTPS_PROXY 环境变量被设置,false
  nc2,timeout,httpIdleTimeoutMs 为 120000,configure_http_client 被调用,client 具有 120s read timeout,false
  nc3,parse-string,"'值为 \"5 min\"'",parse 被调用,返回 300000,false
  nc3,parse-numeric,值为 30000,parse 被调用,返回 30000,false
  nc4,presets,访问 timeout choices,读取 HTTP_IDLE_TIMEOUT_CHOICES,5 个预设均存在,false
  nc5,stub-settings,settings 中设置 httpProxy 与 httpIdleTimeoutMs,Settings 序列化为 JSON,两字段均以 camelCase 出现,false
