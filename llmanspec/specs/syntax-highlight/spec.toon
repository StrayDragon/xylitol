kind: llman.sdd.spec
name: "syntax-highlight"
purpose: "TBD - created by archiving change c150-add-syntax-highlight. Update purpose after archive."
valid_scope[2]: src/,tests/
requirements[3]{req_id,title,statement}:
  s1,"code-highlight","System MUST provide highlight(code language) that returns syntax-highlighted text for common programming languages."
  s2,"language-auto","System MUST support auto-detecting language when not specified."
  s3,"theme-support",System MUST support configurable theme mapping syntax scopes to ANSI style formatters.
scenarios[3]{req_id,id,given,when,then}:
  s1,rust,a Rust code snippet is provided with language set to rust,highlight is called,"output contains ANSI-colored tokens for keywords strings and comments"
  s2,"auto-detect",a Python code snippet is provided without language,"highlight is called with auto-detect",output contains correct highlighting for Python syntax
  s3,"theme-dark",a dark theme is configured with keyword=cyan,highlight is called,Rust keywords in output are wrapped in cyan ANSI escape codes