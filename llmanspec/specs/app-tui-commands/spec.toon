  atm8,atm8-unit,"slash-session-io 约束由产品单测/harness覆盖（非 BDD harness）",审查实现与对应测试,"行为符合本 requirement 陈述",false
  atm9,atm9-unit,"slash-session-info 约束由产品单测/harness覆盖（非 BDD harness）",审查实现与对应测试,"行为符合本 requirement 陈述",false
  atm10,atm10-unit,"slash-session-resume 约束由产品单测/harness覆盖（非 BDD harness）",审查实现与对应测试,"行为符合本 requirement 陈述",false
  atm11,atm11-unit,"slash-session-lifecycle 约束由产品单测/harness覆盖（非 BDD harness）",审查实现与对应测试,"行为符合本 requirement 陈述",false
  atm12,atm12-unit,"slash-reload 约束由产品单测/harness覆盖（非 BDD harness）",审查实现与对应测试,"行为符合本 requirement 陈述",false
  atm13,atm13-unit,"slash-trust 约束由产品单测/harness覆盖（非 BDD harness）",审查实现与对应测试,"行为符合本 requirement 陈述",false
