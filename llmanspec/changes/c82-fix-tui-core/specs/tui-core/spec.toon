kind: llman.sdd.delta
ops[3]{op,req_id,title,statement,from,to,name}:
  modify_requirement,r1,event-loop-starvation,"System MUST implement a select! event loop that, after agent stream exhaustion, stops polling the exhausted stream so input events and frame timer continue to be processed.",null,null,null
  add_requirement,r2,user-message-display,"System MUST display user-submitted messages as TranscriptEntry::User in the transcript, preserving the user's text and message order relative to assistant responses.",null,null,null
  add_requirement,r3,transcript-scrolling,"System MUST support scroll-back in the transcript view via scroll_offset, with PgUp/PgDn and Up/Down keybindings when transcript has focus.",null,null,null
op_scenarios[3]{req_id,id,given,when,then}:
  r1,idle-input,"agent stream has ended and no agent is running","user presses a character key","the character appears in the composer input area within the next frame"
  r2,user-message,"user types and submits a message","the Action::Submit handler runs","the transcript displays the user message with '▶' prefix before the assistant response"
  r3,scroll-down,"transcript has more entries than visible height","user presses PgDn with transcript focused","the view scrolls down by one page, showing older entries"
