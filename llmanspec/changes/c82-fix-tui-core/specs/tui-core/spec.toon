kind: llman.sdd.delta
ops[5]{op,req_id,title,statement,from,to,name}:
  modify_requirement,r1,"event-loop-starvation","System MUST implement a select! event loop that, after agent stream exhaustion, stops polling the exhausted stream so input events and frame timer continue to be processed.",null,null,null
  add_requirement,r2,"user-message-display","System MUST display user-submitted messages as TranscriptEntry::User in the transcript, preserving the user's text and message order relative to assistant responses.",null,null,null
  add_requirement,r3,"transcript-scrolling","System MUST support scroll-back in the transcript view via scroll_offset, with PgUp/PgDn and Up/Down keybindings when transcript has focus.",null,null,null
  add_requirement,r4,"composer-cursor-position","When the composer is empty, the hardware cursor MUST be positioned immediately after the input prompt marker, with the placeholder text rendered dimmed after the cursor. When the composer has text, the cursor MUST sit at the text edit position, not after trailing placeholder text.",null,null,null
  add_requirement,r5,"diff-no-ghost","The differential renderer MUST fully overwrite every changed line and MUST NOT leave stale characters from the previous frame. After any state transition the rendered screen MUST exactly match the fresh layout computed from App state, with no ghosting of old prompt markers or old text. The composer MUST render the user's typed draft verbatim, preserving leading and trailing whitespace (spaces and tabs) the user entered.",null,null,null
op_scenarios[6]{req_id,id,given,when,then}:
  r1,"idle-input",agent stream has ended and no agent is running,user presses a character key,the character appears in the composer input area within the next frame
  r2,"user-message",user types and submits a message,"the Action::Submit handler runs",the transcript displays the user message with '▶' prefix before the assistant response
  r3,"scroll-down",transcript has more entries than visible height,user presses PgDn with transcript focused,"the view scrolls down by one page, showing older entries"
  r4,"empty-cursor","",the composer is empty,the cursor sits right after the prompt and the dimmed placeholder appears after the cursor position
  r4,typing,"",the user types a character into the composer,the cursor follows the typed text with no duplicate prompt markers or stale text left behind
  r5,"no-leftover","",the composer text changes between frames,the new composer line replaces the old one completely with no leftover characters from the previous frame
