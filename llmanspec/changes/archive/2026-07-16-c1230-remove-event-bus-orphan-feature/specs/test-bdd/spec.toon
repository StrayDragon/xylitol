kind: llman.sdd.delta
ops[1]{op,req_id,title,statement,from,to,name}:
  modify_requirement,r1,BDD 全量通过,"BDD 场景集 MUST 保持全量通过（cargo test --test bdd 与 cargo test --lib bdd_scenarios）；未实现的孤儿 feature（如 event-bus）MUST 移除而非保留为债务，其行为由对应模块单测覆盖。",null,null,null
