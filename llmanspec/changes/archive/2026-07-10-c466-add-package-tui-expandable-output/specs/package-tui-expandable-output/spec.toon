kind: llman.sdd.delta
ops[4]{op,req_id,title,statement,from,to,name}:
  add_requirement,meta0,"capability-shell","本 capability 由变更 c466-add-package-tui-expandable-output 引入；归档合并后以 delta 增补的 requirements 为准。本壳 MUST 保持非空以满足 BDD 护栏。",null,null,null
  add_requirement,peo1,"expandable-api","包 MUST 提供 ExpandableOutput 与 render_expandable_output；选项 MUST 含 max_preview_lines、TruncateFrom（Tail 或 Head）、expand_hint；MUST NOT 依赖主 crate xylitol。",null,null,null
  add_requirement,peo2,"collapsed-tail-hint","当 collapsed 且跳过行数大于 0 时 Tail 模式 MUST 在可见尾部之上渲染 dim 提示（含 earlier lines 与 expand_hint）；Head 模式 MUST 在尾部提示 more lines。",null,null,null
  add_requirement,peo3,"streaming-stick-tail","流式追加文本时 collapsed Tail 视口 MUST 继续显示最新视觉行；expanded MUST 显示全文且无 earlier 提示。",null,null,null
op_scenarios[4]{req_id,id,given,when,then}:
  meta0,"shell-present","","列出 llmanspec/specs/package-tui-expandable-output",spec.toon 存在且 purpose 为中文
  peo1,"api-export","","从 xylitol_tui 引用",ExpandableOutput 与 render_expandable_output 可导出
  peo2,"hint-above-tail","文本超过 max_preview_lines","collapsed Tail render","首行含 earlier lines 与 expand_hint 且末行是原文尾"
  peo3,"stream-then-expand","连续 append 多行","collapsed 再 set_expanded","collapsed 贴尾且 expanded 无 earlier 提示"
