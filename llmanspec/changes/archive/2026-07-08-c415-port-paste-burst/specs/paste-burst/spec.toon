kind: llman.sdd.delta
ops[3]{op,req_id,title,statement,from,to,name}:
  add_requirement,pb01,"paste-burst-detector","The TUI MUST provide a PasteBurst detector (pure state machine) that recognizes a non-bracketed paste burst: 8 or more plain characters arriving within 8ms of each other. The detector MUST expose on_plain_char(now) to feed character arrivals and should_insert_newline_instead_of_submit(now) to query whether an imminent Enter should insert a newline rather than submit. The detector MUST NOT buffer characters (the editor inserts text normally); it only decides the Enter behavior. Mirrors pi paste-burst.ts.",null,null,null
  add_requirement,pb02,"time-injected","PasteBurst methods MUST accept an Instant parameter (now) rather than reading wall-clock time internally so tests advance time deterministically via c405 MockClock without thread::sleep. The editor (future port) will pass clock.now() at each call site. This realizes c405 spec tt04 (timing-injectable-clock) for the paste-burst case.",null,null,null
  add_requirement,pb03,"enter-suppress-window","When a burst is detected (8+ chars within the inter-char threshold) PasteBurst MUST open a 120ms enter-suppress window during which should_insert_newline_instead_of_submit returns true and a 30ms active-idle window that keeps the detector active between chars. After the suppress window elapses with no new chars a subsequent Enter MUST submit normally. reset() MUST clear all state (for non-printable keys, bracketed paste, or explicit disable).",null,null,null
op_scenarios[7]{req_id,id,given,when,then}:
  pb01,burst-detected-after-8-fast-chars,"8 plain chars arrive each 1ms apart via on_plain_char","should_insert_newline_instead_of_submit is called immediately after","it returns true (the Enter should insert a newline)"
  pb01,no-burst-slow-typing,"8 plain chars arrive each 20ms apart (slower than the 8ms threshold)","should_insert_newline_instead_of_submit is called","it returns false (normal typing is not a paste burst)"
  pb01,fewer-than-8-chars-no-burst,"only 5 fast chars arrive","should_insert_newline_instead_of_submit is called","it returns false (below the 8-char minimum)"
  pb02,time-boundary-7ms-inside,"two chars arrive 7ms apart","the inter-char gap is checked against the 8ms threshold","7ms is inside the threshold so the consecutive counter increments"
  pb02,time-boundary-9ms-outside,"two chars arrive 9ms apart","the inter-char gap is checked","9ms is outside the threshold so the consecutive counter resets to 1"
  pb03,enter-submits-after-suppress-window,"a burst is detected then 121ms pass with no new chars","should_insert_newline_instead_of_submit is called at +121ms","it returns false (the 120ms suppress window has elapsed)"
  pb03,reset-clears-state,"a burst is in progress and reset() is called","on_plain_char and should_insert_newline are called after reset","the detector behaves as if no chars arrived (no burst)"
