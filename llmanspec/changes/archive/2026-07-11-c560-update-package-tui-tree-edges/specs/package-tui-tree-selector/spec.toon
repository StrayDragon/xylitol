kind: llman.sdd.delta
ops[3]{op,req_id,title,statement,from,to,name}:
  add_requirement,pts00,capability-shell,"本增量由变更 c560-update-package-tui-tree-edges 引入；归档合并后以本 delta 为准。本壳 MUST 保持非空以满足 BDD 护栏。",null,null,null
  add_requirement,pts11,empty-visible-state,"当过滤或搜索导致无可见节点时，TreeSelector MUST 渲染可辨识空态行（主题 no_match 或等价）；MUST NOT 静默输出完全空白列表且无提示。",null,null,null
  add_requirement,pts12,selection-stable-on-filter,"include_node 或搜索串变更后，若先前选中 id 仍在可见列表中则 MUST 保持该选中；否则 MUST 将选中落到可见列表的合理默认项（通常为首项）。",null,null,null
op_scenarios[4]{req_id,id,given,when,then}:
  pts00,shell-present,"","列出 capability package-tui-tree-selector","delta 含 pts11–pts12"
  pts11,no-match,"树有节点","搜索无匹配串",render 含空态提示文案
  pts12,keep-id,"选中某仍可见节点","收紧 include_node 但仍含该 id",选中仍为该 id
  pts12,fallback,"选中节点被过滤掉","刷新可见列表",选中变为可见首项或等价默认
