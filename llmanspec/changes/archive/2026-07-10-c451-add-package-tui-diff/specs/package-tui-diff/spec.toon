kind: llman.sdd.delta
ops[3]{op,req_id,title,statement,from,to,name}:
  add_requirement,ptd1,"diff-component-api","xylitol-tui MUST 提供 Diff 组件（及/或 render_diff_lines），接受 display_diff 文本、unified diff 文本或 old/new 行对，输出 Vec of ANSI 行；主题 MUST 经闭包注入；MUST NOT 依赖主 crate xylitol。",null,null,null
  add_requirement,ptd2,"diff-word-level","当恰好一对相邻删除行与添加行时，Diff MUST 对该对做词级（或字级）对比并用 reverse/word_change 高亮变更片段；多行连续增减 MUST NOT 做词级对比。",null,null,null
  add_requirement,ptd3,"diff-width-cjk","Diff 行宽 MUST 按 visible_width（CJK/emoji）处理；当宽度低于 side-by-side 阈值时 MUST 使用 unified；达到阈值且启用时 MAY 左右对照；MUST NOT 使用 Unicode 表线装饰。",null,null,null
op_scenarios[5]{req_id,id,given,when,then}:
  ptd1,"render-line-pair","","DiffInput::LinePair 含一行删除与一行添加",render 输出含着色的 -/+ 行
  ptd1,"empty-diff","","old 与 new 相同",输出含 (no changes) 或空等价提示
  ptd2,"intra-line-pair","","相邻单行 - 与 + 仅一词不同",变更词带 reverse/word_change
  ptd3,"narrow-unified","","width 小于 side_by_side 阈值且启用 side-by-side 选项",仍渲染 unified 单栏
  ptd3,"cjk-width","","含全角字符的 diff 行",折行/截断按 visible_width 不按字节
