kind: llman.sdd.delta
ops[3]{op,req_id,title,statement,from,to,name}:
  modify_requirement,pab3,包内-DTO-独立,"包对外流式与消息类型 MUST 使用包内自有 LLM 投影 DTO（如 LlmMessage / AiBridgeChunk / AiBridgeUsage）；该 DTO MUST 仅表达发给模型的形状，MUST NOT 再定义与主仓 AgentMessage 平行的 bashExecution / compactionSummary / branchSummary / custom 等会话环境角色；包 MUST NOT 依赖主仓 domain。",null,null,null
  modify_requirement,pab4,主仓映射层,"主仓 infra MUST 提供显式投影 project_for_llm（或等价）：AgentMessage 切片到 bridge LLM DTO；MUST NOT 再靠全量孪生类型加 JSON 往返对齐；agent 与 domain MUST NOT 直接依赖 xylitol_ai_bridge 的 HTTP/vendor SDK 类型。",null,null,null
  add_requirement,pab11,vendor-sdk-first,"OpenAI 兼容路径（Completions、Responses、input_tokens RemoteCount）与 Anthropic 兼容路径（Messages、count_tokens）MUST 优先经厂商官方 Rust SDK Client 接线；hooks MUST 经 SDK middleware（或文档化等价扩展点）接入且保持可移植 HeaderBag/JSON body 语义；新兼容端 MUST 以新 adapter/配置扩展（开闭），MUST NOT 为每个网关分叉改 AgentMessage 或 ReAct。",null,null,null
op_scenarios[5]{req_id,id,given,when,then}:
  pab3,"dto-no-bash-role","审查 bridge 公共消息 enum","列出 role 变体","无 bashExecution/compactionSummary/branchSummary 平行会话角色"
  pab4,"explicit-projection","含 BashExecution 的 AgentMessage 列表","调用 project_for_llm","得到不含独立 bash 角色的 LLM DTO 且内容按规则折叠或跳过"
  pab4,"no-json-twin-map","生成路径装配","审查 infra map","不存在 AgentMessage 与全量 AiBridgeMessage 的 serde_json 往返"
  pab11,"openai-via-sdk","Completions 或 Responses 请求","实现归属","经 async-openai Client（非手写重复 SSE 栈为默认路径）"
  pab11,"open-closed-adapter","新增一 OpenAI-compatible base_url","接线","仅增配置/薄 adapter 不改 AgentMessage"
