kind: llman.sdd.delta
ops[1]{op,req_id,title,statement,from,to,name}:
  modify_requirement,atm1,"slash-exit-model","TUI MUST 解析斜杠命令 /exit（映射 Quit）与 /model：无参 MUST 打开替换 editor 槽的 fuzzy 模型列表（GetAvailableModels + 选定后 SetModel）；有参 /model <id> MUST 直接 SetModel；键入 /model 参数时 MAY/MUST 经包 SlashArgCompletionSource 内联补全（见 ati23），补全写入后仍走有参 SetModel；MUST NOT 再把无参 /model 做成 CycleModel 静默轮换；MUST NOT 引入 /models 主路径；未知斜杠 MUST 显示内联错误且 MUST NOT 崩溃。",null,null,null
op_scenarios[2]{req_id,id,given,when,then}:
  atm1,"model-opens-picker","idle 且会话树关闭","Enter 提交无参 /model","打开 models 槽且不调用 CycleModel"
  atm1,"model-id-after-completion","idle 编辑器经补全得到 /model fake","Enter 提交","SetModel 或等价被调用"
