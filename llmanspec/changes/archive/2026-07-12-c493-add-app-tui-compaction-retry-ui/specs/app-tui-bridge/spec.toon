kind: llman.sdd.delta
ops[2]{op,req_id,title,statement,from,to,name}:
  add_requirement,atb5,"compaction-status-scrollback",产品 bridge 收到 CompactionStart 时 MUST 将 busy status 设为单行短词 Compacting，并 MUST 向 live scrollback 追加一条 muted/System 说明（含 reason）；收到 CompactionEnd 时 MUST 追加完成或 aborted 说明，且若仍处于 Busy MUST 将 status 恢复为 Working；MUST NOT 用多行 status 呈现压缩进度。,null,null,null
  add_requirement,atb6,"auto-retry-status-scrollback",产品 bridge 收到 AutoRetryStart 时 MUST 将 busy status 设为单行 Retry attempt/max_retries；收到 AutoRetryEnd 时若 success=false MUST 向 scrollback 追加失败说明，且若仍处于 Busy MUST 将 status 恢复为 Working；成功结束时若仍 Busy 亦 MUST 恢复 Working；MUST NOT 在 status 行堆叠多行重试详情。,null,null,null
op_scenarios[6]{req_id,id,given,when,then}:
  atb5,"compact-start-status",agent Busy,CompactionStart,status 为 Compacting 且 scrollback 含 reason 说明
  atb5,"compact-end-restores-working",Busy 且 status=Compacting,CompactionEnd aborted=false,scrollback 含 complete 且 status 恢复 Working
  atb5,"compact-end-aborted",Busy 且 Compacting,CompactionEnd aborted=true,scrollback 含 aborted 且 status 恢复 Working
  atb6,"retry-start-status",agent Busy,AutoRetryStart attempt=2 max=5,status 为 Retry 2/5
  atb6,"retry-end-fail-note",Busy 且 Retry 状态,AutoRetryEnd success=false,scrollback 含失败说明且 status 恢复 Working
  atb6,"retry-end-success-restores",Busy 且 Retry 状态,AutoRetryEnd success=true,status 恢复 Working 且无失败 System 行
