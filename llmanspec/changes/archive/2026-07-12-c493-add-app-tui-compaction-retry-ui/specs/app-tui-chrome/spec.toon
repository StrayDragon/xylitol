kind: llman.sdd.delta
ops[1]{op,req_id,title,statement,from,to,name}:
  add_requirement,atc9,"compaction-retry-single-status-line",产品 TUI 在 Compacting 或 Retry n/m 忙碌态时 status 槽 MUST 仍至多独立 1 行（spinner+短词）；压缩/重试细节 MUST 走 scrollback System 行而非增高 status；MUST NOT 常驻多行 compaction/retry chrome。,null,null,null
op_scenarios[2]{req_id,id,given,when,then}:
  atc9,"compacting-one-row",UiModel Busy status=Compacting,UiRoot render,独立 status 至多 1 行且含 Compacting
  atc9,"retry-one-row",UiModel Busy status=Retry 1/3,UiRoot render,独立 status 至多 1 行且含 Retry
