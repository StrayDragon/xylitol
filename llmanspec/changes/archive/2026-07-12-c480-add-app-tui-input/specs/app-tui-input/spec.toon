kind: llman.sdd.delta
ops[3]{op,req_id,title,statement,from,to,name}:
  add_requirement,ati10,"product-host-key-wiring","产品 HostSession MUST 在 agent 忙碌且会话树关闭时将普通 Enter 映射为 Driver::steer、Alt+Enter 映射为 Driver::follow_up；忙碌时 Esc MUST 调用 Driver::abort 并 clear_queue(steer=true, follow_up=false)；MUST NOT 在忙碌 Esc 时打开 c491 stub 树。",null,null,null
  add_requirement,ati11,"product-queue-chrome","产品 TUI 在 steer/follow-up 队列非空时 MUST 在 scrollback 与 status 之间以 muted 色渲染 Steering:/Follow-up: 行及 Alt+Up dequeue 提示（对齐 pi pendingMessagesContainer）；MUST NOT 将排队内容写成 scrollback System [steer]/[follow-up] 墙；Alt+Up MUST 将队列文本还原进 editor 并 clear_queue(steer=true, follow_up=true)。",null,null,null
  add_requirement,ati12,"product-queue-uplink","当 steer/follow-up 从队列注入 agent history 时，runtime MUST 发射 MessageStart/MessageEnd（role=user，带 message）；产品 bridge MUST 将其提交为 scrollback UiEntry::User（与 idle 提交同形）；chrome 随 QueueUpdate 消退后用户文本 MUST 仍留在 transcript；MUST NOT 仅在 chrome 闪现后丢失。",null,null,null
op_scenarios[8]{req_id,id,given,when,then}:
  ati10,busy-enter-steer,"产品 host 忙碌且 editor 非空",按 Enter,"steer 被调用或 pending steer 入队且 editor 清空"
  ati10,busy-alt-enter-followup,"产品 host 忙碌",Alt+Enter 提交文本,"follow_up 被调用或 pending follow-up 入队"
  ati10,busy-esc-abort,"产品 host 忙碌且树关闭",按 Esc,"abort 被请求且不打开会话树"
  ati11,busy-steer-chrome,"产品 host 忙碌且已入队 steer",渲染一帧,"出现 Steering: 行且无 scrollback [steer] System 墙"
  ati11,busy-followup-chrome,"产品 host 忙碌且已入队 follow-up",渲染一帧,"出现 Follow-up: 行与 Alt+Up hint"
  ati11,busy-alt-up-dequeue,"产品 host 忙碌且队列非空",按 Alt+Up,"队列文本进入 editor 且请求 clear 两侧队列"
  ati12,steer-inject-scrollback,"busy 且 steer 已注入",收到 user MessageStart,"scrollback 出现对应用户行"
  ati12,followup-inject-scrollback,"follow-up 注入后 QueueUpdate 清 chrome",渲染,"Follow-up 文本仍在 UiEntry::User 中"
