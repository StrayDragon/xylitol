kind: llman.sdd.delta
ops[2]{op,req_id,title,statement,from,to,name}:
  add_requirement,tui76,"input-cursor-horizontal","The TUI input line MUST support horizontal cursor movement: Left/Right arrows move the cursor by one character (CJK-aware boundary), Home/End jump to start/end. Characters are inserted at the cursor position (not always appended at the end); Backspace deletes the character before the cursor. The rendered cursor column reflects the display width of the text before the cursor (not the whole buffer).",null,null,null
  add_requirement,tui77,"fence-aware-paragraph-commit","The TUI streaming text commit MUST be fence-aware: outside a fenced code block, text commits at paragraph boundaries (blank lines); inside a fenced code block (opened by triple-backtick), all lines accumulate until the closing fence, then the complete code block commits as a single unit. This ensures render_markdown receives complete fence context so syntax highlighting applies during streaming (not deferred to TurnEnd). Blank lines inside a code block do NOT split the block.",null,null,null
op_scenarios[2]{req_id,id,given,when,then}:
  tui76,"cursor-moves-left",the input buffer contains text and the cursor is not at the start,the user presses Left arrow,"the cursor moves left by one character (respecting multi-byte boundaries) and new input inserts at the new position"
  tui77,"code-block-commits-with-highlight",an assistant reply streams a fenced code block containing a blank line between statements,the closing fence arrives during streaming,the complete code block commits as one unit with syntax highlighting (the internal blank line did not split it)