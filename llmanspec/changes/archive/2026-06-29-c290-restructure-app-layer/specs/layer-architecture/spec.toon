kind: llman.sdd.delta
ops[6]{op,req_id,title,statement,from,to,name}:
  modify_requirement,la2,"downward-dependency","infra/ modules MUST NOT import any crate::agent symbol; agent/ modules MUST NOT import any concrete infra/ type (only via runtime_protocol); app/ modules MUST NOT import crate::agent or crate::infra except in the in-process composition root (app/cli/, app/server/, app/rpc.rs, app/composition.rs, app/print.rs). domain/ MUST have zero crate:: internal dependencies and runtime_protocol/ MUST only depend on domain/.",null,null,null
  modify_requirement,la4,"app-layer-name","The interactive surface directory MUST be renamed to app/ and MUST contain all user-facing entry points: cli/, rpc.rs, print.rs, server/, tui/, and gui.rs.",null,null,null
  modify_requirement,la6,"server-under-app","System MUST provide an app::server module (under src/app/server/) that hosts agent + infra runtimes and exposes protocol/ over REST (/api/v1) and WebSocket; the server MUST enforce a single-instance lock.",null,null,null
  modify_requirement,la9,"arch-guard-expanded","The architecture guard MUST enforce via a guard test (src/tests.rs::arch_guard) all of: no infra file imports crate::agent, no agent file imports ANY concrete crate::infra type via a full scan of crate::infra:: in production code, and no app file imports crate::agent or crate::infra except the documented composition roots (app/cli/, app/server/, app/rpc.rs, app/composition.rs, app/print.rs); the scan scope MUST reconcile with la2.",null,null,null
  modify_requirement,la11,"arch-guard-app","The architecture guard MUST verify that app/ modules (excluding the documented composition roots: app/cli/, app/server/, app/rpc.rs, app/composition.rs, and app/print.rs) do not import crate::agent or crate::infra types.",null,null,null
  add_requirement,la15,"app-composition","System MUST provide an app::composition module that centralizes construction of a fully wired Agent from BuildAgentOptions so that CLI, RPC, Server, and TUI do not duplicate Agent wiring code.",null,null,null
op_scenarios[7]{req_id,id,given,when,then}:
  la2,"app-layer-isolated","","a new file under src/app/driver.rs imports crate::infra::tools::BashTool",the architecture guard fails and reports the violation
  la2,"composition-root-allowed","","a file under src/app/composition.rs imports crate::infra::tools::default_tools",the architecture guard allows it as a documented composition root
  la4,"app-dir-exists","",the source tree is inspected after the refactor,src/app exists and src/interactive no longer exists
  la6,"server-dir-moved","",the source tree is inspected after the refactor,src/app/server exists and src/server no longer exists
  la9,"guard-scans-app","","a new app/ file outside the composition roots imports crate::agent",the architecture guard fails and reports the offending file path
  la11,"driver-is-clean","",app/driver.rs is scanned for infra imports,"it contains no crate::infra import"
  la15,"composition-reused","","CLI, RPC, and Server each need an Agent","all three call app::composition::build_agent instead of duplicating wiring code"
