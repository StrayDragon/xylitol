kind: llman.sdd.delta
ops[4]{op,req_id,title,statement,from,to,name}:
  modify_requirement,sr1,"server-hosts-agent","app::server MUST assemble infra runtimes and inject them into agent ports at startup; app::server MUST pass the Agent into AppState so route handlers can invoke it.",null,null,null
  modify_requirement,sr2,"rest-and-ws","app::server MUST expose protocol/ over REST under a /api/v1 prefix (control commands and state queries) and over WebSocket (streaming events); both MUST speak the protocol::Command and protocol::Event types.",null,null,null
  modify_requirement,sr3,"single-instance-lock","app::server MUST acquire a single-instance lock before binding; a second server against the same lock path MUST receive a ServerLockedError.",null,null,null
  modify_requirement,sr10,"export-io-wiring","The app::server runtime composition root MUST construct an infra-provided StdExportIo and inject it as Arc<dyn runtime_protocol::export::ExportIo> when assembling the Agent hosted in AppState, preferably via app::composition::build_agent.",null,null,null
op_scenarios[4]{req_id,id,given,when,then}:
  sr1,"server-under-app","",the source tree is inspected after the change,src/app/server exists and src/server no longer exists
  sr2,"server-rest-ws-under-app","","app::server runtime is started","it exposes REST and WebSocket endpoints speaking protocol::Command and protocol::Event"
  sr3,"server-lock-under-app","","a second app::server process starts against the same lock path",it receives ServerLockedError
  sr10,"server-composition-export-io","","app::server runtime assembles the Agent via app::composition",an Arc<dyn ExportIo> is passed to the Agent
