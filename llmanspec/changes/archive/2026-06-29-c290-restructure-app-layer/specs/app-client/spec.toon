kind: llman.sdd.delta
ops[4]{op,req_id,title,statement,from,to,name}:
  modify_requirement,ic1,"driver-trait","app/ MUST define a Driver trait with a send method (Command to EventStream); all app clients (cli, print, rpc) MUST depend on Driver, never on agent or infra directly. InProcessDriver wraps the agent facade; RemoteDriver wraps WS/REST transport.",null,null,null
  modify_requirement,ic2,"inprocess-driver","app/ MUST provide InProcessDriver under app::driver that holds an Agent and invokes it directly; it is the only app module permitted to import agent::facade and to wire infra ports at construction.",null,null,null
  modify_requirement,ic4,"driver-inprocess","app/ MUST provide InProcessDriver under app::driver that holds Agent ports and invokes the facade directly; it is the only app module permitted to import agent::facade.",null,null,null
  modify_requirement,ic7,"export-io-wiring","The app composition roots (CLI, RPC, and Server) MUST construct an infra-provided StdExportIo and inject it as Arc<dyn runtime_protocol::export::ExportIo> when building the Agent or AgentSession, preferably via app::composition::build_agent.",null,null,null
op_scenarios[4]{req_id,id,given,when,then}:
  ic1,"driver-under-app","",an app client module is inspected,"it imports app::Driver, and src/interactive no longer exists"
  ic2,"inprocess-under-app","",InProcessDriver is constructed under src/app/driver.rs,"it holds an Agent and imports agent::facade only from the agent layer"
  ic4,"driver-allowed-agent","",app/driver.rs is inspected,"it is the only app module permitted to import agent::facade"
  ic7,"composition-injects-export-io","","app::composition::build_agent is called",it constructs and injects Arc<dyn ExportIo> via StdExportIo
