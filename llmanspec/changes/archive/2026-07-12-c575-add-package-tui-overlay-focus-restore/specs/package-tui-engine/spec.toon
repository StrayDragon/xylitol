kind: llman.sdd.delta
ops[3]{op,req_id,title,statement,from,to,name}:
  modify_requirement,pte02,"overlay-handle","TUI::show_overlay MUST return an OverlayHandle that can hide (permanently remove), set_hidden / is_hidden (temporary), and report is_focused. hide MUST restore focus via the focus-restore state machine (topmost visible capturing overlay, else pre_focus FocusTarget after retarget). The handle MUST remain usable only while the overlay entry exists (operations after hide are no-ops).",null,null,null
  modify_requirement,pte03,"overlay-handle-focus-controls","OverlayHandle MUST expose focus and unfocus operations. focus MUST bring a visible overlay (including non_capturing) to the visual front and capture input. unfocus MUST release focus without rebuild; unfocus MAY accept an explicit FocusTarget. TUI MUST implement eligible/blocked/resume overlay focus-restore and reclaim on dispatch_event when focus is not on an overlay.",null,null,null
  add_requirement,pte06,"overlay-focus-restore-sm","TUI MUST maintain overlay focus-restore state inactive/eligible/blocked；当 capturing overlay 获焦时 MUST 进入 eligible；当焦点被临时转到非祖先 root/child 时 MUST 进入 blocked；dispatch_event 在 listener 之后 MUST reclaim eligible 或满足条件的 blocked resume；set_focus(None) 在 clear 策略下 MUST 清除 restore；non_capturing show 与 set_hidden(false) MUST NOT 自动抢焦点。",null,null,null
op_scenarios[6]{req_id,id,given,when,then}:
  pte02,"overlay-hide-restores-prefocus",capturing overlay focused over root editor,OverlayHandle.hide,focus returns to editor pre_focus
  pte03,"overlay-focus-nc-allowed",visible non_capturing overlay,OverlayHandle.focus,overlay is focused and receives subsequent input
  pte03,"overlay-unfocus-no-reclaim",capturing overlay focused,unfocus then dispatch_event,root keeps focus; overlay does not reclaim
  pte06,"reclaim-after-set-focus-steal",capturing overlay visible,set_focus root then dispatch_event,overlay reclaims focus and receives the event
  pte06,"set-focus-none-clears",overlay focused with eligible restore,set_focus None,restore inactive and overlay does not reclaim on next input
  pte06,"nested-retarget-on-hide",parent then child capturing overlays,hide child,focus restores to parent via retargeted pre_focus
