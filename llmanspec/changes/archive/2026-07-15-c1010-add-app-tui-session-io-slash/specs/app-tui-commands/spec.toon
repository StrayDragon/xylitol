kind: llman.sdd.delta
ops[1]{op,req_id,title,statement,from,to,name}:
  add_requirement,atm8,"slash-session-io","产品 TUI idle 时 MUST 解析 /session-compact、/session-export 与 /session-import：/session-compact 无参 MUST 经 dispatch 调用 Compact 并以系统行提示是否压缩；带非空参数 MUST 短错误 usage 且 MUST NOT 调用 Compact；/session-export 可选 path MUST 默认导出 HTML（对齐 pi；无参时可用 Driver/dispatch 默认 export.html），path 以 .jsonl 结尾 MUST 走 ExportJsonl，否则 ExportHtml，成功 MUST 回报写入路径；/session-import 缺 path MUST usage 错误，有 path MUST 先以 editor 槽 Yes/No 确认再 ImportJsonl 并 switch/重建 transcript，取消 MUST NOT 导入；三者 busy 时 MUST 拒绝；SlashCommandSource MUST 列出三者；旧名 /compact /export /import MUST NOT 被识别；MUST 走 app::core::dispatch，MUST NOT 发明平行词表。",null,null,null
op_scenarios[5]{req_id,id,given,when,then}:
  atm8,"compact-bare",产品 idle,提交 /session-compact,Compact 经 dispatch 被调用或 ScriptedDriver compact 被调用
  atm8,"compact-rejects-args",产品 idle,提交 /session-compact please,出现 usage 类错误且未 compact
  atm8,"export-default-html",产品 idle,提交无参 /session-export,走 ExportHtml 或等价且系统行含导出路径
  atm8,"export-jsonl-suffix",产品 idle,提交 /session-export /tmp/out.jsonl,走 ExportJsonl 或等价
  atm8,"import-confirm-cancel",产品 idle,提交 /session-import /tmp/a.jsonl 后在确认槽选 No 或 Esc,未 import 且有取消提示
