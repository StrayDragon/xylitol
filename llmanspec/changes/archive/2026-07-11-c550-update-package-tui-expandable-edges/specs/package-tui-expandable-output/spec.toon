kind: llman.sdd.delta
ops[3]{op,req_id,title,statement,from,to,name}:
  add_requirement,peo0,capability-shell,"本增量由变更 c550-update-package-tui-expandable-edges 引入；归档合并后以本 delta 为准。本壳 MUST 保持非空以满足 BDD 护栏。",null,null,null
  add_requirement,peo4,head-more-hint,"当 TruncateFrom::Head 且 collapsed 并跳过行数大于 0 时，MUST 在可见首部之下渲染 dim 的 more lines 提示（含 expand_hint）；MUST NOT 把该提示放在首部之上冒充 Tail。",null,null,null
  add_requirement,peo5,zero-width-safe,"ExpandableOutput 在 width 为 0 或 1、或文本为空时 MUST 安全返回（空或有界行）；MUST NOT panic。",null,null,null
op_scenarios[4]{req_id,id,given,when,then}:
  peo0,shell-present,"","列出 capability package-tui-expandable-output","delta 含 peo4–peo5"
  peo4,head-hint,"文本超过 max_preview_lines 且 Head","collapsed render","末行附近含 more lines 与 expand_hint 且首行是原文头"
  peo5,empty-text,"",空串 render,不 panic 且行数有界
  peo5,width-one,"多行文本","width=1 collapsed render","不 panic"
