kind: llman.sdd.delta
ops[1]{op,req_id,title,statement,from,to,name}:
  add_requirement,la20,"shared-bootstrap-and-dispatch","app::core MUST host a shared bootstrap module (app::core::bootstrap) centralizing the full assembly path from CLI args to a constructed ReActAgent (config load, ModelRegistry build, trust resolution, resource discovery including templates/context_files/system_prompt/append_system_prompt, compaction settings, permission, build_agent, model select), and a shared dispatch module (app::core::dispatch) centralizing Command variant execution semantics; print (cli), server, and tui MUST call bootstrap, rpc and tui MUST call dispatch, and no surface MAY inline its own assembly or command-dispatch implementation.",null,null,null
op_scenarios[2]{req_id,id,given,when,then}:
  la20,"bootstrap-shared",the source tree after c336,src/app/core/bootstrap.rs and src/app/core/dispatch.rs are inspected,"both exist and cli/mod.rs, server/runtime.rs call bootstrap while rpc.rs and tui/commands.rs call dispatch"
  la20,"no-inlined-assembly","","cli/mod.rs::run and server/runtime.rs are inspected","neither contains inline config-load/registry-build/trust-resolution/resource-discovery logic; both delegate to app::core::bootstrap"
