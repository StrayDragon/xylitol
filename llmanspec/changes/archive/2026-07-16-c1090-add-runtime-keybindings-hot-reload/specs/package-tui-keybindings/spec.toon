kind: llman.sdd.delta
ops[2]{op,req_id,title,statement,from,to,name}:
  add_requirement,pkb01,"owned-user-config","KeybindingsManager MUST 接受拥有型用户覆盖配置（键与和弦为 String），使磁盘 JSON 可热加载；definitions 的 id 仍为包/应用静态目录。set_user_bindings MUST 按 id 合并覆盖；未知 id MUST 忽略且 MUST NOT panic。",null,null,null
  add_requirement,pkb02,"matches-by-id","KeybindingsManager::matches_event MUST 按绑定 id 解析当前生效和弦并与 KeyEvent 比较；默认键在无用户覆盖时 MUST 等于 definitions.default_keys。",null,null,null
op_scenarios[3]{req_id,id,given,when,then}:
  pkb01,"json-override-applies","Manager 已用默认 definitions 构造",set_user_bindings 覆盖某 id 为新和弦,matches_event 对该 id 仅认新和弦
  pkb01,"unknown-id-ignored","用户配置含未知 id",set_user_bindings,不 panic 且已知 id 行为不变
  pkb02,"default-without-override","无用户覆盖",matches_event 使用 default_keys,与定义表一致
