kind: llman.sdd.delta
ops[5]{op,req_id,title,statement,from,to,name}:
  modify_requirement,ar4,"ports-via-builder","Agent construction MUST go through an AgentBuilder that takes the minimal required ports (ModelRegistry, model builder, Arc<dyn XySessionStore>, Arc<dyn XyEventSink>, Arc<dyn XyPermission>) in its constructor and adds every other capability via consuming builder methods with defaults; the Agent::new(session) and Agent::with_ports(...) positional constructors MUST be removed.",null,null,null
  add_requirement,ar21,"agent-builder","System MUST provide an AgentBuilder in agent/ that depends only on runtime_protocol port trait objects and plain data (no concrete infra types, HC-1), defaults tools to an empty ToolSet and bash_executor and export_io to None so a conversation-only agent carries no file or bash or export capability, provides consuming methods tools, system_prompt, hooks, bash, export_io, sandbox, context_files, compaction, max_iterations, and a build method returning Result<Agent, String>.",null,null,null
  add_requirement,ar22,"runtime-mutable-slots","Agent MUST expose turn-level setters set_tools, set_hooks, add_hook, set_sandbox, and set_system_prompt that mutate session-backed capability state and take effect on the NEXT run call; an in-flight turn MUST be unaffected because run snapshots tools, prompt, cancel, and hooks at turn start, so the app or tui layer MAY switch configuration between turns (plan or edit mode) without locks.",null,null,null
  add_requirement,ar23,"hooks-invoked","The ReAct loop MUST consult AgentHooks at the tool-call boundary: before executing a tool it MUST run the before chain where any hook MAY deny the call with a reason that short-circuits to a tool-error result, and after a tool returns it MUST run the after chain where hooks MAY observe or transform the result; when no hooks are registered the loop MUST incur zero overhead. The previous self.hooks field was never read; this requirement wires it.",null,null,null
  add_requirement,ar24,"hook-chains-not-slots","AgentHooks MUST hold before, after, and transform_context as Vec of callbacks appendable at runtime via add_hook, not single Option slots; the steering and follow-up message callbacks MUST be separated into a distinct struct because they are message-injection, not tool-execution interception.",null,null,null
op_scenarios[5]{req_id,id,given,when,then}:
  ar4,"builder-replaces-ctors","Agent::new and Agent::with_ports existed","the change is applied","only AgentBuilder constructs an Agent and the old positional constructors are gone"
  ar21,"builder-minimal-core","a conversation-only agent is desired","AgentBuilder is called with ports and a system prompt only","the agent runs turns with an empty tool set and no bash or export capability and never names a concrete infra type"
  ar22,"turn-snapshot","a turn N is in flight","set_tools is called mid-turn","turn N still uses the old tool set and turn N+1 uses the new set with no lock"
  ar23,"before-chain-denies","a before hook denies the bash tool","the loop reaches the bash call","execute is skipped and a tool-error result is recorded for the LLM"
  ar24,"add-hook-runtime","an agent is already built","add_hook pushes a second before callback","both callbacks run on the next tool call in registration order"
