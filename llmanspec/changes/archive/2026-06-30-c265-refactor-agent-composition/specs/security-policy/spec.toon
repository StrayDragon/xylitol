kind: llman.sdd.delta
ops[4]{op,req_id,title,statement,from,to,name}:
  modify_requirement,s11,"fs-check-permission","Filesystem tools (read, write, edit) SHALL check XyPermission before execution. When a path matches write_denied or does not match read_allowed (when read_allowed is non-empty), the tool SHALL return an access-denied error.",null,null,null
  modify_requirement,s12,"net-check-permission","Bash execution SHALL check XyPermission for network.allowed_domains and network.denied_domains for URLs appearing in command text. When a domain is denied or not in allowed_domains (when allowed_domains is non-empty), the execution SHALL be blocked.",null,null,null
  modify_requirement,s13,"permission-trait","System MUST provide a runtime_protocol::XyPermission trait (renamed from XySandboxEngine) with check_read(path), check_write(path), check_network(domain), and check_process(path) methods returning XyPermissionVerdict (renamed from XySandboxVerdict). The trait is an ADVISORY in-process permission gate consumed by the ReAct loop before tool dispatch; it is NOT a security boundary. Concrete backends (AllowAllPermission for disabled, GlobPolicy for config pattern matching) live in infra/.",null,null,null
  add_requirement,s15,"permission-not-security","Documentation and naming MUST make explicit that XyPermission is advisory: it politely prevents the loop from calling a denied tool but does NOT prevent host-level access, since bash can still remove files and a malicious prompt is not contained. Real isolation MUST come from OS, container, or VM boundaries such as a future tool-routing mode that delegates tool execution into a sandbox; extending XyPermission MUST NOT be treated as adding a security control. This mirrors the pi no-built-in-sandbox stance.",null,null,null
op_scenarios[4]{req_id,id,given,when,then}:
  s11,"s11-renamed","the filesystem enforcement requirement is read","the change is applied","it references XyPermission rather than SandboxEngine"
  s12,"s12-renamed","the network enforcement requirement is read","the change is applied","it references XyPermission rather than SandboxEngine"
  s13,"permission-trait","the permission boundary type is located","its name is checked","it is runtime_protocol::XyPermission returning XyPermissionVerdict with AllowAllPermission and GlobPolicy backends"
  s15,"advisory-not-security","a reader inspects the XyPermission module doc","the doc is read","it states the gate is advisory and not a security boundary and points to OS or container isolation for real containment"
