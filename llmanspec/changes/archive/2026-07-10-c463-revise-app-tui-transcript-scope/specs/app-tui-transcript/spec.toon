kind: llman.sdd.delta
ops[5]{op,req_id,title,statement,from,to,name}:
  modify_requirement,att1,"live-scrollback-output","当前轮 live 用户/助手/系统输出 MUST 写入引擎 scrollback 历史；MUST NOT 截断历史冒充滚动；MUST NOT 以此要求实现 Codex 式可导航 transcript 浏览面（分支回看走会话树）。",null,null,null
  remove_requirement,att2,null,null,null,null,"expandable-app-layer"
  modify_requirement,att4,"tool-block-status-bg","thinking 以外的 tool 可展开块（若呈现）MUST 按执行状态（pending / success / error）为块内每一可见行套全行背景 tint；edit/diff 可展开块 MUST 仅对摘要/header 行套同一 tint，展开后的 Diff 正文 MUST NOT 再套 tool-*-bg；色值 MUST 对齐产品 DESIGN.md 的 tool-*-bg；ANSI MUST 仅用背景 SGR 并以 \\x1b[49m 复位，MUST NOT 用 \\x1b[0m 清 bg以免冲掉内容 fg。",null,null,null
  add_requirement,att6,"no-codex-transcript-view","产品 TUI MUST NOT 实现 Codex 风格的独立 transcript 浏览面或专用 TranscriptView 作为主 UX；历史/分支 travel MUST 经双 Esc 会话树（app-tui session-tree / package TreeSelector）。",null,null,null
  modify_requirement,meta0,"capability-shell","本 capability 约束 live scrollback 行呈现与相关积木复用；MUST NOT 被解读为要求 Codex 式 TranscriptView。本壳 MUST 保持非空以满足 BDD 护栏。",null,null,null
op_scenarios[4]{req_id,id,given,when,then}:
  att1,"live-not-browser","","bridge 产出 live 行","写入 scrollback 且无专用 transcript 浏览器组件"
  att4,"diff-header-only-tint","","展开 edit/diff 块","仅 header 含 tool status bg"
  att6,"tree-not-transcript-browser","","用户要回看分支","走双 Esc 会话树而非 TranscriptView"
  meta0,"shell-live-purpose","","列出 app-tui-transcript","purpose 描述 live scrollback 且禁 Codex 浏览面"
