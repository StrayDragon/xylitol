kind: llman.sdd.delta
ops[1]{op,req_id,title,statement,from,to,name}:
  add_requirement,atc5,"demo-theme-auto-detect","agent_demo MUST 默认使用 Dark token 集；当启用主题自动探测（环境变量或 harness API）时 MUST 经 package terminal_colors 纯函数切换 Light/Dark，并在 chrome（footer 或系统行）暴露当前 theme_mode；MUST NOT 将自动切换设为产品 MVP 默认。",null,null,null
op_scenarios[3]{req_id,id,given,when,then}:
  atc5,"default-dark","未启用 auto","构造 demo","theme_mode 为 Dark"
  atc5,"auto-osc11-light","已启用 auto","注入近白 OSC11 背景","theme_mode 为 Light"
  atc5,"auto-off-ignores-env","未启用 auto 且 COLORFGBG 为亮","调用 apply_theme_detect","theme_mode 仍为 Dark"
