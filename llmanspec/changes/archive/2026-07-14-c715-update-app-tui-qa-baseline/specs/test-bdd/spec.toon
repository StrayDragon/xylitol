kind: llman.sdd.delta
ops[1]{op,req_id,title,statement,from,to,name}:
  add_requirement,bt2,"rstest-bdd-current-and-app-tui","仓库 MUST 使用 crates.io 当前 rstest-bdd / rstest-bdd-macros 兼容最新 beta（本变更目标 0.6.0-beta3 或更新的同系列）；MUST 在 tests/features 增加产品 TUI 相关 .feature，并在 BDD runner（tests/bdd.rs 或其子模块）提供对应 step；既有核心 BDD 场景 MUST 在升级后仍全部通过。",null,null,null
op_scenarios[1]{req_id,id,given,when,then}:
  bt2,"upgrade-and-core-green","Cargo.toml 已升至目标 rstest-bdd 版本","cargo test --test bdd -- --test-threads=1","既有核心 feature 与新增 app-tui feature 均通过"
