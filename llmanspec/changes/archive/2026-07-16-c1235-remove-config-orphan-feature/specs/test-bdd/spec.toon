kind: llman.sdd.delta
ops[1]{op,req_id,title,statement,from,to,name}:
  add_requirement,tb4,配置 BDD 分层,配置加载行为（三层合并、模型/provider 解析、ConfigValue 插值、默认值）MUST 由 src/infra/config 与 src/infra/settings 的单元测试覆盖，MUST NOT 保留无 step 实现的孤儿 feature 作为 BDD 债务。,null,null,null
op_scenarios[1]{req_id,id,given,when,then,feature}:
  tb4,"config-covered-by-unittests",src/infra/config 与 src/infra/settings 含覆盖三层合并/解析/插值/默认值的单测,"cargo test --lib infra::config infra::settings",配置加载行为由单测保障且无孤儿 feature 残留,false
