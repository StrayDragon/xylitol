kind: llman.sdd.delta
ops[1]{op,req_id,title,statement,from,to,name}:
  add_requirement,be7,"abort-reachable-from-runtime","交互 bash 的取消入口 abort_bash MUST 可从 AgentRuntime::abort（&self）到达，无需独占 &mut AgentCapabilities 才能在 Driver::abort 路径上杀进程树；CancellationToken 取消后 MUST 触发既有杀树路径（be2）。",null,null,null
op_scenarios[1]{req_id,id,given,when,then}:
  be7,"runtime-abort-kills","BashExecHandler 持有进行中的 cancel token","仅通过 &self abort_bash / AgentRuntime::abort 取消","进程组被杀且 cancelled 为 true"
