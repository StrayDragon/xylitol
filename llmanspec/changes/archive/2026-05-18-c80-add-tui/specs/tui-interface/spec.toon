kind: llman.sdd.delta
ops[2]{op,req_id,title,statement,from,to,name}:
  add_requirement,r1,"ratatui-components",System MUST implement ~25 ratatui TUI components for chat streaming tool output diff preview and approval flow.,null,null,null
