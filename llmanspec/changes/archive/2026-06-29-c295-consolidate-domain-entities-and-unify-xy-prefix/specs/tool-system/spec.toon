kind: llman.sdd.delta
ops[3]{op,req_id,title,statement,from,to,name}:
  modify_requirement,t17,"工具定义包含 schema","The ToolDefinition presentation type MUST contain an XyToolSchema field instead of duplicating name/description/parameters fields.",null,null,null
  add_requirement,t19,"工具相关类型统一前缀","ToolExecutionMode MUST be renamed to XyToolExecutionMode; the runtime_protocol tool boundary and its signature types MUST use Xy-prefixed names consistently.",null,null,null
  modify_requirement,r1,"工具 trait 前缀","System MUST define the primary tool interface as XyTool; the trait name already carries the Xy prefix and MUST remain consistent with the rest of the runtime_protocol boundary.",null,null,null
op_scenarios[3]{req_id,id,given,when,then}:
  t17,"tool-def-contains-schema","a ToolDefinition is constructed",the change is applied,it stores schema: XyToolSchema and prompt metadata separately
  t19,"tool-mode-renamed","ToolExecutionMode is referenced in code",the change is applied,it is renamed to XyToolExecutionMode everywhere
  r1,"xy-tool-consistent","the runtime_protocol tool boundary is inspected",the change is applied,all tool boundary types carry the Xy prefix
