kind: llman.sdd.delta
ops[4]{op,req_id,title,statement,from,to,name}:
  modify_requirement,ar2,"统一事件输出","Agent runtime MUST emit XyEvent variants from the ReAct loop; the legacy AgentEvent enum MUST be removed.",null,null,null
  modify_requirement,ar5,"统一事件流类型","Agent runtime MUST expose the loop as an async Stream<XyEvent> for consumer layers via XyEventStream.",null,null,null
  modify_requirement,ar4,"端口类型统一命名","Agent::new and Agent::with_ports MUST accept Arc<dyn XySessionStore> and Arc<dyn XyEventSink> using the Xy-prefixed port names.",null,null,null
  add_requirement,ar20,"事件映射自动化","System MUST provide From<&XyEvent> for protocol::Event and TryFrom<&protocol::Event> for XyEvent to replace hand-written proto_to_agent conversions.",null,null,null
op_scenarios[4]{req_id,id,given,when,then}:
  ar2,"no-agent-event","the codebase is searched for AgentEvent enum",rg "enum AgentEvent",zero matches remain
  ar5,"stream-xy-event","a consumer polls the agent runtime stream",the loop emits events,each item is XyEvent
  ar4,"ports-renamed","Agent facade signature is inspected",the change is applied,parameters use XySessionStore and XyEventSink
  ar20,"auto-mapping","a protocol Event is converted back to domain",TryFrom is used,the conversion succeeds for all supported variants
