kind: llman.sdd.delta
ops[4]{op,req_id,title,statement,from,to,name}:
  add_requirement,ar06,"统一公共 API 命名空间","All public types that are part of the project external interface MUST carry the Xy prefix; project-unique internal types and wire types under protocol/ and concrete implementations under infra/ MUST NOT carry the prefix.",null,null,null
  add_requirement,ar07,"消除重复领域实体","System MUST NOT define multiple types for the same domain concept; Usage, StopReason, and Compaction configuration MUST each have exactly one canonical type.",null,null,null
  add_requirement,ar08,"统一事件词汇表","System MUST expose a single domain event vocabulary XyEvent for both the ReAct loop output stream and the lifecycle event bus; runtime_protocol EventSink MUST consume XyEvent directly.",null,null,null
  modify_requirement,ar04,"更新模块地图","src/domain/ MUST host pure domain vocabulary with consolidated entities, src/runtime_protocol/ MUST host Xy-prefixed port contracts and their signature types.",null,null,null
op_scenarios[4]{req_id,id,given,when,then}:
  ar06,"xy-prefix-consistent","public types under runtime_protocol/ and core domain abstractions are inspected after the change",running rg "^pub (struct|enum|type|trait) " on those modules,all interface types have Xy prefix while infra implementations do not
  ar07,"no-duplicate-usage","the codebase is searched for token-usage types",rg "struct (Usage|XyUsage)",exactly one canonical XyUsage remains
  ar08,"single-event-vocab","a turn runs with both stream consumer and lifecycle subscriber",events are emitted,both consumers receive the same XyEvent variants
  ar04,"domain-map-updated","after the change src/domain/ is inspected",consolidated types are present,no duplicate CompactionConfig or XyFinishReason remains
