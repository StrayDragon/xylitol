kind: llman.sdd.delta
ops[3]{op,req_id,title,statement,from,to,name}:
  modify_requirement,a8,"agent-session-store","AgentCapabilities 或 ReAct 运行时 MUST 在每条 user、assistant、toolResult 消息完成时（对齐 pi message_end）经 XySessionStore::append_session_entry 写入当前 session；tool 执行结束后 MUST 持久化对应 toolResult；一轮结束后 session 文件或内存 backend MUST 含本轮消息。MUST NOT 仅把对话留在 ReAct 本地 history 而不写入 store。",null,null,null
  modify_requirement,as27,"event-bus-lifecycle","AgentCapabilities MUST 在 turn 生命周期内发出 turn_start 与 turn_end（或等价 XyEvent）；并 MUST 在消息完成时 auto-persist 到 session store（与 a8 一致），不得只依赖无人订阅的旁路。",null,null,null
  add_requirement,as45,"seed-history-from-store","AgentRuntime::run_with_id（或等价入口）在已有 session 上开新一轮时 MUST 经 store.build_session_context（及既有 SessionEntry→AgentMessage 转换）灌入 history，再追加本轮 user prompt；MUST NOT 每轮从空 history 起步导致多轮丢失上下文。",null,null,null
op_scenarios[4]{req_id,id,given,when,then}:
  a8,"persist-user-assistant",已绑定稳定 session_id 的 Agent 跑完一轮 user→assistant,load_entries(session_id),"含本轮 user 与 assistant 的 SessionEntry::Message"
  a8,"persist-tool-result",一轮含工具调用,工具执行结束,store 含对应 toolResult（或等价 tool）消息条目
  as27,"auto-persist-on-message-end",已启用 session 的 Agent,assistant message_end 发生,该消息已 append 到 session store
  as45,"second-turn-sees-first",同一 session_id 已有第一轮 user/assistant 在 store,第二轮 run_with_id,送给模型的 history 含第一轮消息
