kind: llman.sdd.delta
ops[1]{op,req_id,title,statement,from,to,name}:
  add_requirement,ati20,"bang-busy-hard-reject","产品 TUI 在交互 bang 仍 busy（bash_active）时，用户再次 Enter 提交 ! 或 !! 命令 MUST 硬拒绝：MUST 向用户给出简短提示、MUST 恢复编辑器文本（或等价保留命令体）、MUST NOT 调用第二次 Driver::execute_bash、MUST NOT 排队第二 bang；忙碌时非 bang 前缀文本 MUST 仍按既有 steer 规则处理。",null,null,null
op_scenarios[1]{req_id,id,given,when,then}:
  ati20,"second-bang-rejected",第一 bang 仍在执行,再提交 !echo second,出现拒绝提示且 execute_bash 调用次数仍为 1
