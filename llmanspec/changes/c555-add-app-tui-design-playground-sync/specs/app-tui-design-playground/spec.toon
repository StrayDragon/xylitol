kind: llman.sdd.delta
ops[4]{op,req_id,title,statement,from,to,name}:
  add_requirement,adp0,capability-shell,"本 capability 由变更 c555-add-app-tui-design-playground-sync 引入；归档合并后以本 delta 为准。本壳 MUST 保持非空以满足 BDD 护栏。",null,null,null
  add_requirement,adp1,token-sync-ssot,"playground 的 tokens.css 与 tokens.js MUST 由 sync_tokens.py 从 DESIGN.md frontmatter 生成；手改生成物 MUST NOT 作为长期真值。",null,null,null
  add_requirement,adp2,markdown-slot-align,"playground Markdown 槽示意 MUST 对齐 design/markdown.md：无井号标题前缀、链接为 text (url)、粗体斜体无可见星号包裹。",null,null,null
  add_requirement,adp3,agent-default-ignore,"design/AGENTS.md MUST 写明 Agent 默认忽略 playground/；仅在人类点名路径或粘贴片段时才读。",null,null,null
op_scenarios[5]{req_id,id,given,when,then}:
  adp0,shell-present,"","列出 capability app-tui-design-playground","delta 含 adp0–adp3"
  adp1,sync-runs,"",运行 sync_tokens.py,生成或刷新 tokens.css 与 tokens.js 且无报错
  adp2,md-slot,"",打开 playground Markdown 槽,示意中无井号标题前缀且链接呈 text (url) 形态
  adp2,no-star-chrome,"",查看粗体斜体示意,可见文案无 ** 或成对 * 包裹
  adp3,agents-pointer,"",阅读 design/AGENTS.md,含 Agent 默认忽略 playground 的说明
