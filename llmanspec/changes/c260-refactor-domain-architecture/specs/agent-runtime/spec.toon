kind: llman.sdd.delta
ops[4]{op,req_id,title,statement,from,to,name}:
  modify_requirement,ar1,"thin-agent-loop","The agent/ layer MUST contain only the ReAct loop (runtime/react.rs), hook cut-points (runtime/hooks.rs), event types (runtime/event.rs), and orchestration state (current model/tool selection held as Arc<dyn Port>); it MUST NOT contain prompt formatting, bash execution logic, or output guarding logic inlined in the loop file.",null,null,null
  add_requirement,ar2,"no-rloop-keyword","No source file under src/ MUST use the r#loop raw identifier; the ReAct loop module MUST be named runtime::react.",null,null,null
  add_requirement,ar3,"agent-facade","System MUST provide a single public entry point agent::facade::Agent that interactive layers import; reaching into agent::runtime or agent::session from interactive/ is a layering violation.",null,null,null
  add_requirement,ar4,"ports-only-construction","Agent construction MUST accept only Arc<dyn Port> trait objects (providers, session store, event sink); it MUST NOT accept concrete struct types from infra/.",null,null,null
op_scenarios[4]{req_id,id,given,when,then}:
  ar1,"loop-file-thin","runtime/react.rs is inspected","it is read","it contains only the ReAct algorithm and delegates formatting and execution"
  ar2,"grep-no-rloop","the source tree is grepped for r#loop","the grep runs","zero matches are found"
  ar3,"interactive-via-facade","an interactive/ file imports from agent/","the import is inspected","it imports only agent::facade symbols"
  ar4,"construct-with-ports","Agent::new is called","the arguments are inspected","every argument is an Arc<dyn SomePort> trait object"
