kind: llman.sdd.delta
ops[2]{op,req_id,title,statement,from,to,name}:
  modify_requirement,ts1,"tool-impls-in-infra","Built-in tool implementations (bash, read, write, edit, grep, find, ls, patch, and their helpers accumulator/truncate/process/path_utils) MUST live under infra/tools/ and implement core::ports::XyTool; agent/tools/ MUST retain only the ToolRegistry (the orchestration state Vec<Arc<dyn XyTool>>) and the ToolDefinition presentation type.",null,null,null
  add_requirement,ts2,"tool-registry-in-agent","The ToolRegistry MUST remain in agent/ as the orchestration selection state; tools are injected into it at the composition root from infra::tools.",null,null,null
op_scenarios[2]{req_id,id,given,when,then}:
  ts1,"tools-moved","src/agent/tools is inspected","only registry.rs and definition.rs remain","the built-in tool files live under src/infra/tools/"
  ts2,"registry-stays","the ToolRegistry type is located","its module path is checked","it is agent::tools::registry not infra::tools"
