kind: llman.sdd.delta
ops[3]{op,req_id,title,statement,from,to,name}:
  add_requirement,atc1,"idle-status-omitted","空闲时 status 行 MUST NOT 占用垂直空间（0 行）；忙碌时 MUST 至多 1 行短状态（如 Working / Running tool / Retry）。",null,null,null
  add_requirement,atc2,"footer-minimal","footer MUST 为 1 行 dim 文本，MVP 至少包含 cwd 与 model；放不下时 MUST 截断右侧而非增高。",null,null,null
  add_requirement,atc3,"theme-glyphs-config","颜色 MUST 经应用面语义 token 映射为包组件闭包主题；glyph 档（unicode/ascii）MUST 由显式配置切换，MUST NOT 做运行时字体探测。",null,null,null
op_scenarios[3]{req_id,id,given,when,then}:
  atc1,idle-no-status,"","TUI 空闲","status 槽不占行"
  atc2,footer-one-row,"","渲染空闲帧","最后一行为单行 footer"
  atc3,ascii-glyphs,"","配置 glyph=ascii","用户前缀等为 ascii 档字符"
