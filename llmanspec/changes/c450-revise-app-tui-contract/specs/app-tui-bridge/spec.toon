kind: llman.sdd.delta
ops[4]{op,req_id,title,statement,from,to,name}:
  add_requirement,atb1,"xyevent-to-ui-seam","系统 MUST 在单一 bridge 将 XyEvent 翻译为 UI 专用模型；未识别事件 MUST 降级记录（如 tracing）且 MUST NOT panic。",null,null,null
  add_requirement,atb2,"agent-loop-lifecycle","用户可见忙碌态 MUST 覆盖从提交或 steer 起至 AgentEnd 且 follow-up 队列为空；中间 TurnEnd MUST NOT 被当作整轮结束去清空 streaming 尾或复位 idle。",null,null,null
  add_requirement,atb3,"steer-followup-events","bridge MUST 能消费 QueueUpdate（steer_count / follow_up_count）；display_diff 等工具结果字段 MUST 在 ToolExecutionEnd 路径可被抽取供 transcript 使用。",null,null,null
  add_requirement,atb4,"inprocess-default-remote-retained","TUI 默认 MUST 使用 InProcessDriver；RemoteDriver 类型与远控能力 MUST 保留以支持日后远程 server 控制，MUST NOT 删除。",null,null,null
op_scenarios[4]{req_id,id,given,when,then}:
  atb1,unknown-event,"","收到未映射 XyEvent","记录日志且 UI 不崩溃"
  atb2,tool-turn-middle,"","工具调用后出现中间 TurnEnd","UI 仍保持 busy 并继续消费后续事件"
  atb3,queue-update,"","steer 与 follow-up 入队","UI 收到 QueueUpdate 计数"
  atb4,remote-type-kept,"","检查 Driver 实现","InProcess 为默认且 RemoteDriver 仍存在"
