kind: llman.sdd.delta
ops[3]{op,req_id,title,statement,from,to,name}:
  modify_requirement,tui61,"markdown-scope-full","The TUI MarkdownRenderer MUST render at minimum: headings (#), bold/code inline, fenced code blocks (with language label and background color), unordered lists, ordered lists, task lists, blockquotes, tables, and CJK-aware paragraph wrapping. Syntax highlighting of fenced code blocks is provided by a syntect backend (tui70/tui71); OSC8 hyperlinks and streaming incremental markdown parsing remain excluded. Streaming text in the mutable last line stays plain text; markdown rendering applies only after a line is finalized and committed to scrollback.",null,null,null
  add_requirement,tui70,"vendored-markdown-renderer","The TUI markdown rendering MUST be backed by the vendored ratatui-markdown core (src/app/tui/vendor/ratatui_markdown/, derived from https://github.com/celestia-island/ratatui-markdown under SySL-1.0 with LICENSE + NOTICE preserved) rather than a hand-written parser, so the renderer inherits full CommonMark/GFM coverage (tables, task lists, nested blockquotes) maintained upstream. The MarkdownStyle adapter (for_user/for_assistant/for_thinking) MUST remain the single seam RenderedLine::to_lines consumes, hiding the vendored theme types from the render.rs caller.",null,null,null
  add_requirement,tui71,"code-highlight-fallback","The TUI code block syntax highlighting (via syntect + two-face, default-fancy pure-Rust backend) MUST highlight fenced code blocks in recognized languages using a fixed dark theme (CatppuccinMocha), and MUST fall back to plain unstyled text when the language is unrecognized OR the input exceeds safety limits (512 KB / 10000 lines), so rendering never blocks or panics on pathological input.",null,null,null
op_scenarios[5]{req_id,id,given,when,then}:
  tui61,"table-renders",an assistant reply containing a GFM table is finalized and rendered via TestBackend,the buffer is inspected,the table headers and rows render in aligned columns (not flat text)
  tui70,"vendored-backs-rendering",the markdown rendering source is inspected,the render_markdown entry point is read,"it delegates to vendored MarkdownRenderer/Parser (not hand-written), MarkdownStyle remains the only seam"
  tui70,"license-preserved",the vendor directory is inspected,LICENSE and NOTICE files are checked,"the SySL-1.0 full text and source attribution are present"
  tui71,"recognized-language-highlighted",a fenced rs code block is rendered via TestBackend,the buffer cell styles are inspected,"code spans carry non-default styles (syntax highlighting applied)"
  tui71,"unrecognized-language-fallback",a fenced unknownlang code block is rendered via TestBackend,the buffer is inspected,"the code renders as plain unstyled text (no panic, no highlight)"
