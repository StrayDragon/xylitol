kind: llman.sdd.delta
ops[3]{op,req_id,title,statement,from,to,name}:
  add_requirement,ati15,"product-bash-prefix-border","产品 TUI 中当编辑器文本 trim 后以 ! 或 !! 开头时，Editor 操作区边框 MUST 切换为 bash 强调色（对齐 DESIGN success 前景）；去掉该前缀后 MUST 恢复默认 muted 边框。",null,null,null
  add_requirement,ati16,"product-idle-bang-execute","产品 idle 且会话树关闭时，Enter 提交以 ! 或 !! 开头的非空命令 MUST 调用 Driver::execute_bash（经 Command::Bash / dispatch），MUST NOT 调用 Driver::run；!! 前缀 MUST 设置 exclude_from_context=true，单 ! 为 false；命令体为空时 MUST 提示且 MUST NOT 执行。",null,null,null
  add_requirement,ati17,"product-external-editor-stub","产品 Host MUST 将 Ctrl+G 绑定为外部编辑器入口：至少记录/系统提示或 stub 回写；harness 路径 MUST NOT 强制 spawn 真实 $EDITOR；真编辑器路径 MAY 使用 with_terminal_suspended 边界（对齐 design/bash-mode.md）。",null,null,null
op_scenarios[7]{req_id,id,given,when,then}:
  ati15,bang-enables,"editor 文本为 !ls",sync 边框,边框为 success 强调色
  ati15,clear-restores,曾处于 bash 边框,文本改为 hello 后 sync,边框恢复 muted
  ati16,bang-executes,idle 且 editor 为 !echo hi,Enter,"execute_bash 被调用且 run 未被调用"
  ati16,bangbang-exclude,idle 且 editor 为 !!echo x,Enter,exclude_from_context 为 true
  ati16,empty-bang,idle 且 editor 仅为 !,Enter,出现提示且未执行 bash
  ati16,slash-wins,idle 且 editor 为 /exit,Enter,走 slash 退出而非 bash
  ati17,ctrl-g-stub,产品 host 可测环境,Ctrl+G,不崩且有 stub/系统提示可观测
