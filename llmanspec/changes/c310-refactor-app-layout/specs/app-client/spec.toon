kind: llman.sdd.delta
ops[4]{op,req_id,title,statement,from,to,name}:
  modify_requirement,ic2,"inprocess-driver","app/ MUST provide InProcessDriver under app::core::driver that holds an Agent and invokes it directly; it is the only app module permitted to import agent::facade and to wire infra ports at construction.",null,null,null
  modify_requirement,ic4,"driver-inprocess","app/ MUST provide InProcessDriver under app::core::driver that holds Agent ports and invokes the facade directly; it is the only app module permitted to import agent::facade.",null,null,null
  modify_requirement,ic6,"print-event-completeness","app::cli::print MUST handle all AgentEvent variants including TurnStart, TurnEnd, MessageStart, MessageEnd, MessageUpdate, ToolExecutionUpdate, and CompactionEnd.",null,null,null
  modify_requirement,ic7,"export-io-wiring","The app composition roots (CLI, RPC, and Server) MUST construct an infra-provided StdExportIo and inject it as Arc<dyn runtime_protocol::export::ExportIo> when building the Agent or AgentSession, preferably via app::core::composition::build_agent.",null,null,null
op_scenarios[4]{req_id,id,given,when,then}:
  ic2,"inprocess-under-app","",InProcessDriver is constructed under src/app/core/driver.rs,"it holds an Agent and imports agent::facade only from the agent layer"
  ic4,"driver-allowed-agent","",app/core/driver.rs is inspected,"it is the only app module permitted to import agent::facade"
  ic6,"print-all-events",the agent emits a TurnStart then a MessageUpdate then a TurnEnd,"cli/print.rs renders them",all three events produce visible output (not silently dropped)
  ic7,"composition-injects-export-io","","app::core::composition::build_agent is called",it constructs and injects Arc<dyn ExportIo> via StdExportIo
