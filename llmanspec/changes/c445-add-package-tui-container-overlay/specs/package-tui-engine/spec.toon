kind: llman.sdd.delta
ops[4]{op,req_id,title,statement,from,to,name}:
  add_requirement,pte01,"container-vertical-stack","The xylitol-tui package MUST provide a Container component that holds an ordered list of child Components, renders by concatenating each child's render(width) lines in order, invalidates all children on invalidate, and does NOT automatically fan out InputEvent to children (focus routing remains the TUI / host responsibility). Container MUST expose add_child, remove_child, and clear.",null,null,null
  add_requirement,pte02,"overlay-handle","TUI::show_overlay MUST return an OverlayHandle that can hide (permanently remove), set_hidden / is_hidden (temporary), and report is_focused. hide MUST restore focus to the previous focus target or the next visible capturing overlay. The handle MUST remain usable only while the overlay entry exists (operations after hide are no-ops).",null,null,null
  add_requirement,pte03,"overlay-handle-focus-controls","OverlayHandle MUST expose focus and unfocus operations that bring the overlay to the visual front / release focus without requiring the host to rebuild the overlay stack. Full pi-style eligible/blocked focus-restore state machine is NOT required in this change.",null,null,null
  add_requirement,pte04,"image-surface-optional","The package MUST NOT require the Image component or full terminal_image encode path for the primary agent_demo / app-shell wiring. is_image_line (and any minimal helpers the width invariant needs) MUST remain. Unused image encode/UI surface MAY be removed or feature-gated.",null,null,null
op_scenarios[5]{req_id,id,given,when,then}:
  pte01,container-concatenates-children,"a Container holds Text(a) then Text(b)","render(width) is called","the output lines are a then b in order"
  pte01,container-does-not-fanout-input,"a Container has a child Input","Container.handle_input receives a Key event","the child Input does not receive the event unless the host/TUI focused that child directly"
  pte02,overlay-hide-removes-from-composite,"an overlay is shown via show_overlay","OverlayHandle.hide is called then the frame is rendered","the overlay content is absent from the composed lines"
  pte03,overlay-focus-brings-front,"two overlays are on the stack","OverlayHandle.focus is called on the lower one","that overlay is treated as the focused/front overlay for subsequent input routing policy"
  pte04,agent-demo-builds-without-image,"the xylitol-tui package is built with default features","agent_demo and cargo test -p xylitol-tui run","they succeed without depending on the Image component API"
