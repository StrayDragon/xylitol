kind: llman.sdd.delta
ops[3]{op,req_id,title,statement,from,to,name}:
  modify_requirement,atc2,footer-minimal,"产品 footer MUST 为 1 行 dim 文本；字段序为 cwd 与 model（形如 `cwd · model`），并在可获得 ContextTokenEstimate 时追加 `· used … tokens`（文案按 TokenProvenance：Api/RemoteCount/LocalTokenizer 为 used N tokens，Heuristic 为 used ~N tokens，Unknown 为 used ? tokens）；队列非空时可加 `q:sN|fM ·` 前缀；无估计数据时 MUST NOT 伪造 used 0；MUST NOT 常驻快捷键墙；放不下时 MUST 截断右侧而非增高。",null,null,null
  add_requirement,atc13,footer-token-provenance,"当 footer 展示上下文 token 占用时，文案 MUST 反映 Driver::estimate_context_tokens 返回的 TokenProvenance：精确来源（Api/RemoteCount/LocalTokenizer）MUST 使用无波浪号的 used N tokens；Heuristic MUST 使用 used ~N tokens；Unknown MUST 使用 used ? tokens；MUST NOT 将 Heuristic 显示为无 ~ 的精确值。",null,null,null
  add_requirement,atc14,footer-token-refresh,"产品 host MUST 在 session tree travel 换叶、一轮 agent turn 结束后回到 idle、以及 compact 成功后刷新 footer token 字段；刷新 MUST 经 Driver 只读 estimate_context_tokens（或等价 seam），MUST NOT 在每个 TextDelta 上全量本地 tokenizer.encode。",null,null,null
op_scenarios[6]{req_id,id,given,when,then}:
  atc2,"footer-with-used-tokens","已有 ContextTokenEstimate 且 provenance 为 Api","渲染 footer","末行含 used N tokens 且仍为单行 dim"
  atc2,"footer-omit-when-no-estimate","尚无 estimate 结果","渲染 footer","含 cwd 与 model 且不含伪造的 used 0"
  atc13,"heuristic-tilde","estimate provenance 为 Heuristic","渲染 footer token 字段","文案为 used ~N tokens"
  atc13,"unknown-question","estimate provenance 为 Unknown","渲染 footer token 字段","文案为 used ? tokens"
  atc14,"travel-refreshes-token","用户 travel 到另一 leaf","下一帧 footer","token 字段对应该 leaf 的 estimate"
  atc14,"no-per-delta-encode","正在流式生成","仅处理 TextDelta","不因每个 delta 触发全文 tokenizer.encode"
