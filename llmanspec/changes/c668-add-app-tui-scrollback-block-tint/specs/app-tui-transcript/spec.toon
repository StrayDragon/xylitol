kind: llman.sdd.delta
ops[3]{op,req_id,title,statement,from,to,name}:
  modify_requirement,att9,"product-bash-result-scrollback","产品 TUI 在 idle bang 提交时 MUST 立即将命令写入 live scrollback 可着色块；执行中 MUST 为 pending tint；完成后 MUST 按成功或失败或 cancelled 切换 tool-*-bg；bang Esc 取消 MUST 在该块内呈现 (cancelled) 而非 agent 的 Aborted；exit_code 非 0 MUST 以 error 前景或 error tint 强调；MUST NOT 为此引入 Codex 式 TranscriptView。",null,null,null
  add_requirement,att10,"scrollback-block-gap","产品 live scrollback 相邻块之间 MUST 有空行隔开：每个块渲染前与渲染后各至少一行空白（对齐 agent_demo 与 pi Spacer）；MUST NOT 把块内容粘成连续墙。",null,null,null
  add_requirement,att11,"bang-block-tint-via-helper","bang 块全行背景 MUST 复用 apply_background_to_line（或等价包 API）与 DESIGN tool-*-bg；MUST NOT 在应用面手写第二套 pad+bg。",null,null,null
op_scenarios[5]{req_id,id,given,when,then}:
  att9,uplink-on-submit,"idle 提交 bang 命令",立即渲染,"scrollback 已含命令行且块为 pending tint"
  att9,cancelled-in-block,"bang 执行中 Esc 取消",渲染,"块内含 (cancelled) 且无独立 agent Aborted 行"
  att9,ok-output,"idle 已 execute_bash 成功",渲染,"scrollback 含命令或输出片段且成功 tint"
  att10,gap-between-blocks,"scrollback 含相邻 user 与 bang 块",render,"两块内容行之间至少两行空白"
  att11,reuse-apply-bg,"渲染 bang 块","调用 apply_background_to_line","而非手写 pad+bg"
