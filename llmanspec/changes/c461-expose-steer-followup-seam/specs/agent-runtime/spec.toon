kind: llman.sdd.delta
ops[4]{op,req_id,title,statement,from,to,name}:
  add_requirement,ar-q1,"pending-message-queue","Agent runtime MUST 提供 PendingMessageQueue（或等价类型），支持 enqueue、drain、clear、has_items，以及 all 与 one-at-a-time 两种 drain 模式；steer 与 follow-up MUST 使用各自独立队列。",null,null,null
  add_requirement,ar-q2,"react-drains-steering","ReAct 循环 MUST 在每一轮模型调用之前 drain steering 队列并将消息注入历史；MUST 在即将结束（无 tool_calls 且将停止）之前 drain follow-up 队列；若 follow-up 非空 MUST 继续循环而非立即 AgentEnd。",null,null,null
  add_requirement,ar-q3,"queue-update-events","入队、drain 与 clear 之后，runtime MUST 发射 XyEvent::QueueUpdate，携带当前 steer_count 与 follow_up_count。",null,null,null
  add_requirement,ar-q4,"abort-clears-steer-keeps-followup","调用 abort 时 runtime MUST 清空 steering 队列且 MUST NOT 清空 follow-up 队列；显式 clear_queue API MUST 允许分别或同时清空两侧队列。",null,null,null
op_scenarios[4]{req_id,id,given,when,then}:
  ar-q1,drain-one,"","one-at-a-time 模式下队列有两条消息并 drain","仅返回一条且队列仍剩一条"
  ar-q2,steer-inject,"","流中 steer 一条消息后当前工具轮结束进入下一模型轮","steering 文本已注入历史并参与下一轮模型调用"
  ar-q3,emit-counts,"","steer 入队一条","观察到 QueueUpdate 且 steer_count 为 1"
  ar-q4,abort-keep-fu,"steer 与 follow-up 队列均非空","调用 abort","steer 为空且 follow-up 仍保留原消息"
