kind: llman.sdd.delta
ops[9]{op,req_id,title,statement,from,to,name}:
  add_requirement,ptm0,capability-shell,"本 capability 由变更 c530-update-package-tui-markdown 引入；归档合并后以本 delta 增补的 requirements 为准。本壳 MUST 保持非空以满足 BDD 护栏。",null,null,null
  add_requirement,ptm1,heading-sgr-no-hash,"Markdown 渲染标题时 MUST 用主题色与 bold/underline 表达 H1–H6 层级；可见文本 MUST NOT 包含 # 或 ## 等井号前缀。",null,null,null
  add_requirement,ptm2,link-text-url,"Markdown 渲染链接时 MUST 输出可见形态 text (url)；图片 MUST 输出 alt (url)（无 alt 则用 url）；MUST NOT 仅依赖不可选中的 OSC 或丢弃 URL。",null,null,null
  add_requirement,ptm3,code-block-no-fence,"Markdown 代码块 MUST 仅输出代码内容行（可选缩进与 highlight_code 高亮）；MUST NOT 输出围栏行、语言标签条或行号墙。",null,null,null
  add_requirement,ptm4,inline-roundtrip-markers,"Markdown 行内代码、粗体、斜体、删除线的可见文本 MUST 分别保留 `、**、*、~~ 标记以便复制 round-trip。",null,null,null
  add_requirement,ptm5,quote-no-box,"Markdown 引用 MUST 仅用 quote 色与 italic（或等价 SGR）；MUST NOT 使用竖线或盒线装饰前缀。",null,null,null
  add_requirement,ptm6,table-space-align,"Markdown 表格 MUST 以空格对齐列宽显示；表头 MAY bold 与 underline；MUST NOT 使用盒线表字符；MUST NOT 为装饰输出管道符。",null,null,null
  add_requirement,ptm7,list-and-hr,"Markdown 列表 MUST 使用 - 或数字点号标记且嵌套用空格缩进；MUST NOT 使用树线装饰。分隔线 MUST 为短线或空行；MUST NOT 拉满近全宽装饰线墙。",null,null,null
  add_requirement,ptm8,highlight-callback-only,"语法高亮 MUST 仅经 MarkdownTheme.highlight_code 可选回调注入；xylitol-tui 默认依赖 MUST NOT 捆绑 syntect。fg 着色在内联阶段完成；若设置 bg_color 则 MUST 在行宽 padding 后经 apply_background_to_line 铺满。",null,null,null
op_scenarios[12]{req_id,id,given,when,then}:
  ptm0,shell-present,"","列出 capability package-tui-markdown","delta 含 ptm0–ptm8 且 purpose 级说明为中文"
  ptm1,h1-no-hash,"","渲染一级标题 Hello","剥 ANSI 后行内含 Hello 且不含井号前缀"
  ptm1,h2-underline-path,"","渲染二级标题","输出经 heading 主题且无井号前缀"
  ptm2,link-form,"","渲染 [docs](https://ex.com)","剥 ANSI 后含 docs (https://ex.com)"
  ptm2,image-form,"","渲染图片含 alt 与 url","剥 ANSI 后含 alt (url) 形态"
  ptm3,no-fence,"","渲染 fenced rust 代码块","剥 ANSI 后不含三反引号围栏行且含代码正文"
  ptm4,inline-code-ticks,"","渲染行内 code","剥 ANSI 后含反引号包裹的 code"
  ptm4,bold-markers,"","渲染粗体词","剥 ANSI 后含 ** 标记"
  ptm5,quote-no-bar,"","渲染引用段落","剥 ANSI 后不含竖线装饰前缀"
  ptm6,table-spaces,"","渲染两列表格","剥 ANSI 后列空格对齐且无盒线字符"
  ptm7,list-markers,"","渲染无序与有序列表","输出含 - 与数字点号且无树线"
  ptm8,no-default-syntect,"","未启用 highlight feature 的默认构建","Markdown 仍可渲染且包默认依赖无 syntect"
