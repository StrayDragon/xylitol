# 本仓专用忽略项（按用途分组；新增条目先判断是否属于本仓）

# 构建与缓存
/target/
target/
**/llmanspec/.context/

# 本地工具安装（cccc-rs 等经 .tools/）
.tools/

# 会话临时笔记与队列（_HANDOFF / *.tmp.md 不入库）
_HANDOFF/
.tmp/

# 评测产物（Harbor 默认在当前目录写 jobs/）
/jobs/
tools/eval/logs/
tools/eval/.venv/

# 本机配置与凭据
.xylitol/config.yaml
.xylitol/config.yml
.env
*.env
!*.env.example


# 生成产物（guest wasm 不得入库）
plugins/xylitol-official-plugin-codemode/assets/guest.wasm

# 通用临时文件
*.tmp
*.tmp.md
*.bak
*~
*.log
.DS_Store

# Rust
**/*.rs.bk

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
.coverage
.ruff_cache/

# Node（examples/plugins/bun-demo）
node_modules/
dist/

# vendor 例外：gherkin 补丁入库
vendor/
!vendor/
!vendor/**
