# ── xylitol Secret Environment Template ───────────────────────────────
#
# Copy this file to secret.env (same directory) and fill in your keys.
#   cp secret.env.example secret.env
#
# secret.env is gitignored — your secrets stay local.
# Shareable settings belong in config.yaml (not here, not config.local.yaml).
#
# xylitol loads secret.env automatically at config load (program-parsed
# dotenv — not bash `source`). Search order:
#   1. $XYLITOL_CONFIG_DIR or ~/.config/xylitol/secret.env
#   2. <project>/.xylitol/secret.env  (overrides unset keys from global)
# Keys already present in the process environment are never overwritten.
#
# In YAML config files you can reference:
#   api_key: "{{ secret.OPENAI_API_KEY }}"
#   api_key: "{{ env.OPENAI_API_KEY }}"
#   api_key: $OPENAI_API_KEY
#
# Learn more: https://github.com/straydragon/xylitol

# ── LLM Provider API Keys ────────────────────────────────────────────
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...

# ── Optional: Override model or log level per project ────────────────
# XYLITOL_LOG_LEVEL=debug

# Optional: Langfuse OTLP (local / self-host). Used when [otel].exporter=otlp-http.
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_BASE_URL=http://localhost:3000
